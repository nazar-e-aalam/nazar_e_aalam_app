            {
              "id": 5728,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
              "translated_name": "Mola wake Mlezi alipomwita katika bonde takatifu la Tuwaa, akamwambia:"
            },
            {
              "id": 5729,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
              "translated_name": "Nenda kwa Firauni. Hakika yeye amezidi jeuri."
            },
            {
              "id": 5730,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
              "translated_name": "Umwambie: Je! Unapenda kujitakasa?"
            },
            {
              "id": 5731,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
              "translated_name": "Nami nitakuongoza ufike kwa Mola wako Mlezi, upate kumcha."
            },
            {
              "id": 5732,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "20",
              "arabic_name": "فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ",
              "translated_name": "Basi alimwonyesha Ishara kubwa."
            },
            {
              "id": 5733,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "21",
              "arabic_name": "فَكَذَّبَ وَعَصَىٰ",
              "translated_name": "Lakini alikadhibisha na akaasi."
            },
            {
              "id": 5734,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "22",
              "arabic_name": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
              "translated_name": "Kisha alirudi nyuma, akaingia kufanya juhudi."
            },
            {
              "id": 5735,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "23",
              "arabic_name": "فَحَشَرَ فَنَادَىٰ",
              "translated_name": "Akakusanya watu akanadi."
            },
            {
              "id": 5736,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "24",
              "arabic_name": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
              "translated_name": "Akasema: Mimi ndiye Mola wenu Mlezi mkuu kabisa."
            },
            {
              "id": 5737,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "25",
              "arabic_name": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ",
              "translated_name": "Basi hapo Mwenyezi Mungu akamshika kumuadhibu kwa la mwisho na la mwanzo."
            },
            {
              "id": 5738,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "26",
              "arabic_name": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ",
              "translated_name": "Kwa hakika katika haya yapo mazingatio kwa wanaoogopa Mwenyezi Mungu."
            },
            {
              "id": 5739,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "27",
              "arabic_name": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
              "translated_name": "Je, ni vigumu zaidi kukuumbeni nyinyi au mbingu? Yeye ndiye aliyeijenga!"
            },
            {
              "id": 5740,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "28",
              "arabic_name": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
              "translated_name": "Akainua paa lake, na akaitengeneza vizuri."
            },
            {
              "id": 5741,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "29",
              "arabic_name": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
              "translated_name": "Na akautia giza usiku wake, na akautokeza mchana wake."
            },
            {
              "id": 5742,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "30",
              "arabic_name": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
              "translated_name": "Na juu ya hivyo ameitandaza ardhi."
            },
            {
              "id": 5743,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "31",
              "arabic_name": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
              "translated_name": "Akatoa ndani yake maji yake na malisho yake."
            },
            {
              "id": 5744,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "32",
              "arabic_name": "وَٱلْجِبَالَ أَرْسَىٰهَا",
              "translated_name": "Na milima akaisimamisha imara."
            },
            {
              "id": 5745,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "33",
              "arabic_name": "مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
              "translated_name": "Kwa manufaa yenu na mifugo yenu."
            },
            {
              "id": 5746,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "34",
              "arabic_name": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ",
              "translated_name": "Basi itakapofika hiyo Balaa kubwa,"
            },
            {
              "id": 5747,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "35",
              "arabic_name": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ",
              "translated_name": "Siku ambayo mtu atakumbuka aliyoyafanya,"
            },
            {
              "id": 5748,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "36",
              "arabic_name": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ",
              "translated_name": "Na Jahannamu itadhihirishwa kwa mwenye kuona,"
            },
            {
              "id": 5749,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "37",
              "arabic_name": "فَأَمَّا مَن طَغَىٰ",
              "translated_name": "Basi ama yule aliyezidi ujeuri,"
            },
            {
              "id": 5750,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "38",
              "arabic_name": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
              "translated_name": "Na akakhiari maisha ya dunia,"
            },
            {
              "id": 5751,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "39",
              "arabic_name": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
              "translated_name": "Kwa hakika Jahannamu ndiyo makazi yake!"
            },
            {
              "id": 5752,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "40",
              "arabic_name": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
              "translated_name": "Na ama yule anayeogopa kusimamishwa mbele ya Mola wake Mlezi, na akajizuilia nafsi yake na matamanio,"
            },
            {
              "id": 5753,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "41",
              "arabic_name": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ",
              "translated_name": "Basi huyo, Bustani ya mbinguni itakuwa ndiyo makazi yake!"
            },
            {
              "id": 5754,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "42",
              "arabic_name": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا",
              "translated_name": "Wanakuuliza Saa (ya Kiyama) itakuwa lini?"
            },
            {
              "id": 5755,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "43",
              "arabic_name": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ",
              "translated_name": "Una nini wewe hata uitaje?"
            },
            {
              "id": 5756,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "44",
              "arabic_name": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ",
              "translated_name": "Kwa Mola wako Mlezi ndio mwisho wake."
            },
            {
              "id": 5757,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "45",
              "arabic_name": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا",
              "translated_name": "Kwa hakika wewe ni mwonyaji tu kwa mwenye kuihofu."
            },
            {
              "id": 5758,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "46",
              "arabic_name": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا",
              "translated_name": "Ni kama kwamba wao siku watakapoiona (hiyo Saa) hawakukaa ila jioni moja tu, au mchana wake."
            }
          ],
          "page_arabic_ayah": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى (١٦)  ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ (١٧)  فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ (١٨)  وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ (١٩)  فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ (٢٠)  فَكَذَّبَ وَعَصَىٰ (٢١)  ثُمَّ أَدْبَرَ يَسْعَىٰ (٢٢)  فَحَشَرَ فَنَادَىٰ (٢٣)  فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ (٢٤)  فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ (٢٥)  إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ (٢٦)  ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا (٢٧)  رَفَعَ سَمْكَهَا فَسَوَّىٰهَا (٢٨)  وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا (٢٩)  وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ (٣٠)  أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا (٣١)  وَٱلْجِبَالَ أَرْسَىٰهَا (٣٢)  مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ (٣٣)  فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ (٣٤)  يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ (٣٥)  وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ (٣٦)  فَأَمَّا مَن طَغَىٰ (٣٧)  وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا (٣٨)  فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ (٣٩)  وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ (٤٠)  فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ (٤١)  يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا (٤٢)  فِيمَ أَنتَ مِن ذِكْرَىٰهَآ (٤٣)  إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ (٤٤)  إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا (٤٥)  كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا (٤٦)",
