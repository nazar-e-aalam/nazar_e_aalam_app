              "arabic_name": "وَٱلنَّـٰزِعَـٰتِ غَرْقًا",
              "translated_name": "Ninaapa kwa wanaokomoa kwa nguvu."
            },
            {
              "id": 5714,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "وَٱلنَّـٰشِطَـٰتِ نَشْطًا",
              "translated_name": "Na kwa wanaotoa kwa upole."
            },
            {
              "id": 5715,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "وَٱلسَّـٰبِحَـٰتِ سَبْحًا",
              "translated_name": "Na wanaoogelea sawasawa."
            },
            {
              "id": 5716,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "فَٱلسَّـٰبِقَـٰتِ سَبْقًا",
              "translated_name": "Wakishindana mbio kweli kweli."
            },
            {
              "id": 5717,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "فَٱلْمُدَبِّرَٰتِ أَمْرًا",
              "translated_name": "Wakidabiri mambo."
            },
            {
              "id": 5718,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
              "translated_name": "Siku kitakapotetemeka cha kutetemeka."
            },
            {
              "id": 5719,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "تَتْبَعُهَا ٱلرَّادِفَةُ",
              "translated_name": "Kifuate cha kufuatia."
            },
            {
              "id": 5720,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",
              "translated_name": "Siku hiyo nyoyo zitapigapiga."
            },
            {
              "id": 5721,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "أَبْصَـٰرُهَا خَـٰشِعَةٌ",
              "translated_name": "Macho yatainama chini."
            },
            {
              "id": 5722,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
              "translated_name": "Sasa wanasema: Ati kweli tutarudishwa kwenye hali ya kwanza?"
            },
            {
              "id": 5723,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً",
              "translated_name": "Hata tukiwa mifupa iliyobunguliwa?"
            },
            {
              "id": 5724,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
              "translated_name": "Wanasema: Basi marejeo hayo ni yenye hasara!"
            },
            {
              "id": 5725,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ",
              "translated_name": "Kwa hakika hayo ni ukelele mmoja tu."
            },
            {
              "id": 5726,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
              "translated_name": "Mara watakuwa kwenye Uwanda wa mkutano!"
            },
            {
              "id": 5727,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
              "translated_name": "Je! Imekufikia hadithi ya Musa?"
            }
          ],
          "page_arabic_ayah": "وَٱلنَّـٰزِعَـٰتِ غَرْقًا (١)  وَٱلنَّـٰشِطَـٰتِ نَشْطًا (٢)  وَٱلسَّـٰبِحَـٰتِ سَبْحًا (٣)  فَٱلسَّـٰبِقَـٰتِ سَبْقًا (٤)  فَٱلْمُدَبِّرَٰتِ أَمْرًا (٥)  يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ (٦)  تَتْبَعُهَا ٱلرَّادِفَةُ (٧)  قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ (٨)  أَبْصَـٰرُهَا خَـٰشِعَةٌ (٩)  يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ (١٠)  أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً (١١)  قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ (١٢)  فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ (١٣)  فَإِذَا هُم بِٱلسَّاهِرَةِ (١٤)  هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ (١٥)",
