              "chapter_id": 56,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "وَكُنتُمْ أَزْوَٰجًا ثَلَـٰثَةً",
              "translated_name": "Na nyinyi mtakuwa namna tatu."
            },
            {
              "id": 4987,
              "chapter_id": 56,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",
              "translated_name": "Basi watakuwepo wa kuliani; je, ni wepi wa kuliani?"
            },
            {
              "id": 4988,
              "chapter_id": 56,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "وَأَصْحَـٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ",
              "translated_name": "Na wa kushotoni; je, ni wepi wa kushotoni?"
            },
            {
              "id": 4989,
              "chapter_id": 56,
              "verses_translate_name": "Verses",
