            {
              "id": 5020,
              "chapter_id": 56,
              "verses_translate_name": "Verses",
              "verses_number": "41",
              "arabic_name": "وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ",
