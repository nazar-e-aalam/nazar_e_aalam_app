              "arabic_name": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا",
              "translated_name": "Na milima itakaposagwasagwa."
            },
            {
              "id": 4985,
              "chapter_id": 56,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "فَكَانَتْ هَبَآءً مُّنۢبَثًّا",
              "translated_name": "Basi iwe mavumbi yanayopeperushwa."
            },
            {
