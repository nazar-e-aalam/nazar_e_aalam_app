              "chapter_id": 56,
              "verses_translate_name": "Verses",
              "verses_number": "47",
              "arabic_name": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ",
