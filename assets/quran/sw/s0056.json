              "id": 5016,
              "chapter_id": 56,
              "verses_translate_name": "Verses",
              "verses_number": "37",
              "arabic_name": "عُرُبًا أَتْرَابًا",
              "translated_name": "Wanapendana na waume zao, hirimu moja."
