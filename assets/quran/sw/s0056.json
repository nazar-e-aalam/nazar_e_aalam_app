            },
            {
              "id": 5021,
              "chapter_id": 56,
              "verses_translate_name": "Verses",
              "verses_number": "42",
              "arabic_name": "فِى سَمُومٍ وَحَمِيمٍ",
              "translated_name": "Katika upepo wa moto, na maji yanayochemka."
            },
            {
              "id": 5022,
              "chapter_id": 56,
              "verses_translate_name": "Verses",
              "verses_number": "43",
              "arabic_name": "وَظِلٍّ مِّن يَحْمُومٍ",
