            },
            {
              "id": 5538,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "43",
              "arabic_name": "قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ",
