              "verses_translate_name": "Verses",
              "verses_number": "46",
              "arabic_name": "وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ",
              "translated_name": "Na tulikuwa tukiikanusha Siku ya Malipo."
            },
            {
              "id": 5542,
