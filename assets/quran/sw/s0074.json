            },
            {
              "id": 5539,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "44",
              "arabic_name": "وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ",
              "translated_name": "Wala hatukuwa tukiwalisha masikini."
            },
            {
              "id": 5540,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
