              "translated_name": "Na Mola wako Mlezi mtukuze!"
            },
            {
              "id": 5499,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "وَثِيَابَكَ فَطَهِّرْ",
              "translated_name": "Na nguo zako, zisafishe."
            },
            {
              "id": 5500,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "وَٱلرُّجْزَ فَٱهْجُرْ",
              "translated_name": "Na yaliyo machafu yahame!"
            },
            {
              "id": 5501,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "وَلَا تَمْنُن تَسْتَكْثِرُ",
              "translated_name": "Wala usitoe kwa kutaraji kuzidishiwa."
            },
            {
              "id": 5502,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "وَلِرَبِّكَ فَٱصْبِرْ",
              "translated_name": "Na kwa ajili ya Mola wako Mlezi, subiri!"
            },
            {
              "id": 5503,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ",
              "translated_name": "Basi litakapopulizwa baragumu."
            },
            {
              "id": 5504,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "فَذَٰلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ",
              "translated_name": "Siku hiyo, basi, itakuwa siku ngumu."
            },
            {
              "id": 5505,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "عَلَى ٱلْكَـٰفِرِينَ غَيْرُ يَسِيرٍ",
              "translated_name": "Kwa makafiri haitakuwa nyepesi."
            },
            {
              "id": 5506,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًا",
              "translated_name": "Niache peke yangu na niliyemuumba."
            },
            {
              "id": 5507,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "وَجَعَلْتُ لَهُۥ مَالًا مَّمْدُودًا",
              "translated_name": "Na nikamjaalia awe na mali mengi."
            },
            {
              "id": 5508,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "وَبَنِينَ شُهُودًا",
              "translated_name": "Na wana wanaoonekana."
            },
            {
              "id": 5509,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "وَمَهَّدتُّ لَهُۥ تَمْهِيدًا",
              "translated_name": "Na nikamtegenezea mambo vizuri kabisa."
            },
            {
              "id": 5510,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "ثُمَّ يَطْمَعُ أَنْ أَزِيدَ",
              "translated_name": "Kisha anatumai nimzidishie!"
            },
            {
              "id": 5511,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "كَلَّآ ۖ إِنَّهُۥ كَانَ لِـَٔايَـٰتِنَا عَنِيدًا",
              "translated_name": "Hasha! Kwani hakika yeye alikuwa akizifanyia ukaidi Aya zetu!"
            },
            {
              "id": 5512,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "سَأُرْهِقُهُۥ صَعُودًا",
              "translated_name": "Nitamtesa kwa mateso yasiowezekana."
            }
          ],
          "page_arabic_ayah": "يَـٰٓأَيُّهَا ٱلْمُدَّثِّرُ (١)  قُمْ فَأَنذِرْ (٢)  وَرَبَّكَ فَكَبِّرْ (٣)  وَثِيَابَكَ فَطَهِّرْ (٤)  وَٱلرُّجْزَ فَٱهْجُرْ (٥)  وَلَا تَمْنُن تَسْتَكْثِرُ (٦)  وَلِرَبِّكَ فَٱصْبِرْ (٧)  فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ (٨)  فَذَٰلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ (٩)  عَلَى ٱلْكَـٰفِرِينَ غَيْرُ يَسِيرٍ (١٠)  ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًا (١١)  وَجَعَلْتُ لَهُۥ مَالًا مَّمْدُودًا (١٢)  وَبَنِينَ شُهُودًا (١٣)  وَمَهَّدتُّ لَهُۥ تَمْهِيدًا (١٤)  ثُمَّ يَطْمَعُ أَنْ أَزِيدَ (١٥)  كَلَّآ ۖ إِنَّهُۥ كَانَ لِـَٔايَـٰتِنَا عَنِيدًا (١٦)  سَأُرْهِقُهُۥ صَعُودًا (١٧)",
