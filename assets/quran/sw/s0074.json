              "verses_translate_name": "Verses",
              "verses_number": "24",
              "arabic_name": "فَقَالَ إِنْ هَـٰذَآ إِلَّا سِحْرٌ يُؤْثَرُ",
              "translated_name": "Na akasema: Haya si chochote ila ni uchawi ulionukuliwa."
            },
            {
              "id": 5520,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "25",
              "arabic_name": "إِنْ هَـٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ",
              "translated_name": "Haya si chochote ila kauli ya binadamu."
            },
            {
              "id": 5521,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "26",
              "arabic_name": "سَأُصْلِيهِ سَقَرَ",
              "translated_name": "Nitakuja mtia kwenye Moto wa Saqar."
            },
            {
              "id": 5522,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "27",
              "arabic_name": "وَمَآ أَدْرَىٰكَ مَا سَقَرُ",
              "translated_name": "Na nini kitakujuulisha ni nini huo Moto wa Saqar?"
            },
            {
              "id": 5523,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "28",
              "arabic_name": "لَا تُبْقِى وَلَا تَذَرُ",
              "translated_name": "Haubakishi wala hausazi."
            },
            {
              "id": 5524,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "29",
              "arabic_name": "لَوَّاحَةٌ لِّلْبَشَرِ",
              "translated_name": "Unababua ngozi iwe nyeusi."
            },
            {
              "id": 5525,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "30",
              "arabic_name": "عَلَيْهَا تِسْعَةَ عَشَرَ",
              "translated_name": "Juu yake wapo kumi na tisa."
            },
            {
              "id": 5526,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "31",
              "arabic_name": "وَمَا جَعَلْنَآ أَصْحَـٰبَ ٱلنَّارِ إِلَّا مَلَـٰٓئِكَةً ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَـٰنًا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ وَٱلْكَـٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَـٰذَا مَثَلًا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ",
              "translated_name": "Na hatukuwafanya walinzi wa Motoni ila ni Malaika, wala hatukuifanya idadi yao hiyo ila kuwatatanisha waliokufuru, wapate kuwa na yakini waliopewa Kitabu, na wazidi Imani wale walioamini, wala wasiwe na shaka waliopewa Kitabu na Waumini, na wapate kusema wenye maradhi katika nyoyo zao na makafiri: \"Mwenyezi Mungu amekusudia nini kwa mfano huu?\" Ndiyo kama hivyo Mwenyezi Mungu humwacha apotee amtakaye, na humwongoa amtakaye. Na hapana yeyote anayejua majeshi ya Mola wako Mlezi ila Yeye tu. Na haya si chochote ila ni ukumbusho kwa binadamu."
            },
            {
              "id": 5527,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "32",
              "arabic_name": "كَلَّا وَٱلْقَمَرِ",
              "translated_name": "Hasha! Naapa kwa mwezi!"
            },
            {
              "id": 5528,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "33",
              "arabic_name": "وَٱلَّيْلِ إِذْ أَدْبَرَ",
              "translated_name": "Na kwa usiku unapokucha!"
            },
            {
              "id": 5529,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "34",
              "arabic_name": "وَٱلصُّبْحِ إِذَآ أَسْفَرَ",
              "translated_name": "Na kwa asubuhi inapopambazuka!"
            },
            {
              "id": 5530,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "35",
              "arabic_name": "إِنَّهَا لَإِحْدَى ٱلْكُبَرِ",
              "translated_name": "Hakika huo Moto ni katika mambo yaliyo makubwa kabisa!"
            },
            {
              "id": 5531,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "36",
              "arabic_name": "نَذِيرًا لِّلْبَشَرِ",
              "translated_name": "Ni onyo kwa binaadamu."
            },
            {
              "id": 5532,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "37",
              "arabic_name": "لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ",
              "translated_name": "Kwa anayetaka miongoni mwenu kutangulia au kuchelewa."
            },
            {
              "id": 5533,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "38",
              "arabic_name": "كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ",
              "translated_name": "Kila nafsi imo rahanini kwa mabaya iliyoyachuma."
            },
            {
              "id": 5534,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "39",
              "arabic_name": "إِلَّآ أَصْحَـٰبَ ٱلْيَمِينِ",
              "translated_name": "Isipokuwa watu wa kuliani."
            },
            {
              "id": 5535,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "40",
              "arabic_name": "فِى جَنَّـٰتٍ يَتَسَآءَلُونَ",
              "translated_name": "Hao watakuwa katika Mabustani, wawe wanaulizana"
            },
            {
              "id": 5536,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
              "verses_number": "41",
              "arabic_name": "عَنِ ٱلْمُجْرِمِينَ",
              "translated_name": "Habari za wakosefu:"
            },
            {
              "id": 5537,
              "chapter_id": 74,
              "verses_translate_name": "Verses",
