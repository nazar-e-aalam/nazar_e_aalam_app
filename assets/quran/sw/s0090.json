              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ",
              "translated_name": "Ati anadhani hapana yeyote atakayemuweza?"
            },
            {
              "id": 6029,
              "chapter_id": 90,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا",
              "translated_name": "Anasema: Nimeteketeza chungu ya mali."
            },
            {
              "id": 6030,
              "chapter_id": 90,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ",
