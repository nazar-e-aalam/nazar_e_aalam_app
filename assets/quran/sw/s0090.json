              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "وَلِسَانًا وَشَفَتَيْنِ",
              "translated_name": "Na ulimi, na midomo miwili?"
            },
            {
              "id": 6033,
              "chapter_id": 90,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ",
              "translated_name": "Na tukambainishia zote njia mbili?"
            },
