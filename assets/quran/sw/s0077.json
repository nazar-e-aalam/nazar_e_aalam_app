            },
            {
              "id": 5647,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "25",
              "arabic_name": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
              "translated_name": "Kwani hatukuifanya ardhi yenye kukusanya."
            },
            {
              "id": 5648,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "26",
              "arabic_name": "أَحْيَآءً وَأَمْوَٰتًا",
              "translated_name": "Walio hai na maiti?"
            },
            {
              "id": 5649,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "27",
              "arabic_name": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا",
              "translated_name": "Na ndani yake tukaweka milima mirefu yenye kuthibiti, na tunakunywesheni maji matamu?"
            },
            {
              "id": 5650,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "28",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "Ole wao siku hiyo hao wanaokanusha!"
            },
            {
              "id": 5651,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "29",
              "arabic_name": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
              "translated_name": "Nendeni kwenye adhabu mliyokuwa mkiikanusha!"
            },
            {
              "id": 5652,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "30",
              "arabic_name": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ",
              "translated_name": "Nendeni kwenye kivuli chenye mapande matatu!"
            },
            {
              "id": 5653,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "31",
              "arabic_name": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
              "translated_name": "Hakikingi moto, wala hakiwaepushi na mwako."
            },
            {
              "id": 5654,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "32",
              "arabic_name": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ",
              "translated_name": "Hakika Moto huo unatoa macheche kama majumba!"
            },
            {
              "id": 5655,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "33",
              "arabic_name": "كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ",
              "translated_name": "Kama kwamba ni ngamia wa rangi ya manjano!"
            },
            {
              "id": 5656,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "34",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "Ole wao siku hiyo hao wanaokanusha!"
            },
            {
              "id": 5657,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "35",
              "arabic_name": "هَـٰذَا يَوْمُ لَا يَنطِقُونَ",
              "translated_name": "Hii ni siku ambayo hawatatamka kitu."
            },
            {
              "id": 5658,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "36",
              "arabic_name": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ",
              "translated_name": "Wala hawataruhusiwa kutoa udhuru."
            },
            {
              "id": 5659,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "37",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "Ole wao siku hiyo hao waliokanusha!"
            },
            {
              "id": 5660,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "38",
              "arabic_name": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ",
              "translated_name": "Hii ndiyo siku ya kupambanua. Tumekukusanyeni nyinyi na waliotangulia."
            },
            {
              "id": 5661,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "39",
              "arabic_name": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ",
              "translated_name": "Ikiwa mnayo hila, nifanyieni hila Mimi!"
            },
            {
              "id": 5662,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "40",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "Ole wao siku hiyo hao waliokanusha!"
            },
            {
              "id": 5663,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "41",
              "arabic_name": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ",
              "translated_name": "Hakika wacha Mungu watakuwa katika vivuli na chemchemi."
            },
            {
              "id": 5664,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "42",
              "arabic_name": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ",
              "translated_name": "Na matunda wanayoyapenda."
            },
            {
              "id": 5665,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "43",
              "arabic_name": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ",
              "translated_name": "Kuleni na kunyweni kwa furaha kwa yale mliyokuwa mkiyatenda."
            },
            {
              "id": 5666,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "44",
              "arabic_name": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
              "translated_name": "Hakika ndio kama hivyo tunavyowalipa watendao mema."
            },
            {
              "id": 5667,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "45",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "Ole wao siku hiyo hao wanaokanusha!"
            },
            {
              "id": 5668,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "46",
              "arabic_name": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ",
              "translated_name": "Kuleni na mjifurahishe kidogo tu. Hakika nyinyi ni wakosefu!"
            },
