              "arabic_name": "وَٱلْمُرْسَلَـٰتِ عُرْفًا",
              "translated_name": "Ninaapa kwa zinazotumwa kwa upole!"
            },
            {
              "id": 5624,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "فَٱلْعَـٰصِفَـٰتِ عَصْفًا",
              "translated_name": "Na zinazovuma kwa kasi!"
            },
            {
              "id": 5625,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "وَٱلنَّـٰشِرَٰتِ نَشْرًا",
              "translated_name": "Na zikaeneza maeneo yote!"
            },
            {
              "id": 5626,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "فَٱلْفَـٰرِقَـٰتِ فَرْقًا",
              "translated_name": "Na zinazofarikisha zikatawanya!"
            },
            {
              "id": 5627,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "فَٱلْمُلْقِيَـٰتِ ذِكْرًا",
              "translated_name": "Na zinazopeleka mawaidha!"
            },
            {
              "id": 5628,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "عُذْرًا أَوْ نُذْرًا",
              "translated_name": "Kuwa udhuru au kuonya."
            },
            {
              "id": 5629,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ",
              "translated_name": "Hakika mnayoahidiwa bila ya shaka yatakuwa!"
            },
            {
              "id": 5630,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
              "translated_name": "Wakati nyota zitakapofutwa."
            },
            {
              "id": 5631,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
              "translated_name": "Na mbingu zitakapopasuliwa."
            },
            {
              "id": 5632,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
              "translated_name": "Na milima itakapopeperushwa."
            },
            {
              "id": 5633,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
              "translated_name": "Na Mitume watakapowekewa wakati wao."
            },
            {
              "id": 5634,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "لِأَىِّ يَوْمٍ أُجِّلَتْ",
              "translated_name": "Kwa siku gani hiyo wamewekewa muda huo?"
            },
            {
              "id": 5635,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "لِيَوْمِ ٱلْفَصْلِ",
              "translated_name": "Kwa Siku ya kupambanua!"
            },
            {
              "id": 5636,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
              "translated_name": "Na nini kitakachokujuulisha siku ya kupambanua ni nini?"
            },
            {
              "id": 5637,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "Ole wao, siku hiyo hao wanaokanusha!"
            },
            {
              "id": 5638,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ",
              "translated_name": "Kwani hatukuwaangamiza waliotangulia?"
            },
            {
              "id": 5639,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ",
              "translated_name": "Kisha tukawafuatilizia waliofuatia?"
            },
            {
              "id": 5640,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
              "translated_name": "Ndio kama hivi tuwatendavyo wakosefu!"
            },
            {
              "id": 5641,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "Ole wao siku hiyo hao wanaokanusha!"
            }
          ],
          "page_arabic_ayah": "وَٱلْمُرْسَلَـٰتِ عُرْفًا (١)  فَٱلْعَـٰصِفَـٰتِ عَصْفًا (٢)  وَٱلنَّـٰشِرَٰتِ نَشْرًا (٣)  فَٱلْفَـٰرِقَـٰتِ فَرْقًا (٤)  فَٱلْمُلْقِيَـٰتِ ذِكْرًا (٥)  عُذْرًا أَوْ نُذْرًا (٦)  إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ (٧)  فَإِذَا ٱلنُّجُومُ طُمِسَتْ (٨)  وَإِذَا ٱلسَّمَآءُ فُرِجَتْ (٩)  وَإِذَا ٱلْجِبَالُ نُسِفَتْ (١٠)  وَإِذَا ٱلرُّسُلُ أُقِّتَتْ (١١)  لِأَىِّ يَوْمٍ أُجِّلَتْ (١٢)  لِيَوْمِ ٱلْفَصْلِ (١٣)  وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ (١٤)  وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ (١٥)  أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ (١٦)  ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ (١٧)  كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ (١٨)  وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ (١٩)",
