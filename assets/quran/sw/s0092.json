              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
              "translated_name": "Ama mwenye kutoa na akamcha Mungu."
            },
