              "chapter_id": 92,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
              "translated_name": "Tutamrahisishia yawe mepesi."
            },
