              "verses_translate_name": "Verses",
              "verses_number": "1",
              "arabic_name": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ",
              "translated_name": "Je, imekufikia habari ya Msiba wa kufudikiza?"
            },
            {
              "id": 5969,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ",
              "translated_name": "Siku hiyo nyuso zitainama."
            },
            {
              "id": 5970,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "عَامِلَةٌ نَّاصِبَةٌ",
              "translated_name": "Zikifanya kazi, nazo taabani."
            },
            {
              "id": 5971,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "تَصْلَىٰ نَارًا حَامِيَةً",
              "translated_name": "Ziingie katika Moto unaowaka."
            },
            {
              "id": 5972,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
              "translated_name": "Zikinyweshwa kutoka chemchemi inayochemka."
            },
            {
              "id": 5973,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
              "translated_name": "Hawatakuwa na chakula isipokuwa kichungu chenye miba."
            },
            {
              "id": 5974,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
              "translated_name": "Hakinenepeshi wala hakiondoi njaa."
            },
            {
              "id": 5975,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
              "translated_name": "Siku hiyo nyuso nyengine zitakuwa kunjufu."
            },
            {
              "id": 5976,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "لِّسَعْيِهَا رَاضِيَةٌ",
              "translated_name": "Zitakuwa radhi kwa juhudi yao."
            },
            {
              "id": 5977,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "فِى جَنَّةٍ عَالِيَةٍ",
              "translated_name": "Katika Bustani ya juu."
            },
            {
              "id": 5978,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً",
              "translated_name": "Hawatasikia humo upuuzi."
            },
            {
              "id": 5979,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "فِيهَا عَيْنٌ جَارِيَةٌ",
              "translated_name": "Humo imo chemchemi inayomiminika."
            },
            {
              "id": 5980,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ",
              "translated_name": "Humo vimo viti vilivyonyanyuliwa."
            },
            {
              "id": 5981,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "وَأَكْوَابٌ مَّوْضُوعَةٌ",
              "translated_name": "Na bilauri zilizopangwa."
            },
            {
              "id": 5982,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "وَنَمَارِقُ مَصْفُوفَةٌ",
              "translated_name": "Na matakia safu safu."
            },
            {
              "id": 5983,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "وَزَرَابِىُّ مَبْثُوثَةٌ",
              "translated_name": "Na mazulia yaliyotandikwa."
            },
            {
              "id": 5984,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
              "translated_name": "Je! Hawamtazami ngamia jinsi alivyoumbwa?"
            },
            {
              "id": 5985,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
              "translated_name": "Na mbingu jinsi ilivyoinuliwa?"
            },
            {
              "id": 5986,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
              "translated_name": "Na milima jinsi ilivyowekwa imara?"
            },
            {
              "id": 5987,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "20",
              "arabic_name": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
              "translated_name": "Na ardhi jinsi ilivyotandazwa?"
            },
            {
              "id": 5988,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "21",
              "arabic_name": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ",
              "translated_name": "Basi kumbusha! Hakika wewe ni Mkumbushaji."
            },
            {
              "id": 5989,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "22",
              "arabic_name": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
              "translated_name": "Wewe si mwenye kuwatawalia."
            },
            {
              "id": 5990,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "23",
              "arabic_name": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
              "translated_name": "Lakini anayerudi nyuma na kukataa."
            },
            {
              "id": 5991,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "24",
              "arabic_name": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
              "translated_name": "Basi Mwenyezi Mungu atamuadhibu kwa adhabu iliyo kubwa kabisa!"
            },
            {
              "id": 5992,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "25",
              "arabic_name": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
              "translated_name": "Hakika ni kwetu Sisi ndio marejeo yao."
            },
            {
              "id": 5993,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "26",
              "arabic_name": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
              "translated_name": "Kisha hakika ni juu yetu Sisi hisabu yao!"
            }
          ],
          "page_arabic_ayah": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ (١)  وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ (٢)  عَامِلَةٌ نَّاصِبَةٌ (٣)  تَصْلَىٰ نَارًا حَامِيَةً (٤)  تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ (٥)  لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ (٦)  لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ (٧)  وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ (٨)  لِّسَعْيِهَا رَاضِيَةٌ (٩)  فِى جَنَّةٍ عَالِيَةٍ (١٠)  لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً (١١)  فِيهَا عَيْنٌ جَارِيَةٌ (١٢)  فِيهَا سُرُرٌ مَّرْفُوعَةٌ (١٣)  وَأَكْوَابٌ مَّوْضُوعَةٌ (١٤)  وَنَمَارِقُ مَصْفُوفَةٌ (١٥)  وَزَرَابِىُّ مَبْثُوثَةٌ (١٦)  أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ (١٧)  وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ (١٨)  وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ (١٩)  وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ (٢٠)  فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ (٢١)  لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ (٢٢)  إِلَّا مَن تَوَلَّىٰ وَكَفَرَ (٢٣)  فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ (٢٤)  إِنَّ إِلَيْنَآ إِيَابَهُمْ (٢٥)  ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم (٢٦)",
