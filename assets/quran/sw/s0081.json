              "verses_number": "1",
              "arabic_name": "إِذَا ٱلشَّمْسُ كُوِّرَتْ",
              "translated_name": "Jua litakapokunjwa,"
            },
            {
              "id": 5802,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
              "translated_name": "Na nyota zikazimwa,"
            },
            {
              "id": 5803,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
              "translated_name": "Na milima ikaondolewa,"
            },
            {
              "id": 5804,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
              "translated_name": "Na ngamia wenye mimba pevu watakapoachwa wasishughulikiwe,"
            },
            {
              "id": 5805,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
              "translated_name": "Na wanyama wa mwituni wakakusanywa,"
            },
            {
              "id": 5806,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
              "translated_name": "Na bahari zikawaka moto,"
            },
            {
              "id": 5807,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
              "translated_name": "Na nafsi zikaunganishwa,"
            },
            {
              "id": 5808,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
              "translated_name": "Na msichana aliyezikwa hai atakapoulizwa,"
            },
            {
              "id": 5809,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
              "translated_name": "Kwa kosa gani aliuliwa?"
            },
            {
              "id": 5810,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
              "translated_name": "Na madaftari yatakapoenezwa,"
            },
            {
              "id": 5811,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
              "translated_name": "Na mbingu itakapotanduliwa,"
            },
            {
              "id": 5812,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
              "translated_name": "Na Jahannamu itakapochochewa,"
            },
            {
              "id": 5813,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
              "translated_name": "Na Bustani ya mbinguni ikasongezwa karibu,"
            },
            {
              "id": 5814,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
              "translated_name": "Kila nafsi itajua ilichokihudhurisha."
            },
            {
              "id": 5815,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
              "translated_name": "Ninaapa kwa nyota zinaporejea nyuma."
            },
            {
              "id": 5816,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "ٱلْجَوَارِ ٱلْكُنَّسِ",
              "translated_name": "Zinazokwenda, kisha zikajificha."
            },
            {
              "id": 5817,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
              "translated_name": "Na kwa usiku unapopungua."
            },
            {
              "id": 5818,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
              "translated_name": "Na kwa asubuhi inapopambazuka."
            },
            {
              "id": 5819,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
              "translated_name": "Kwamba hakika bila ya shaka hii ni kauli ya Mjumbe mtukufu."
            },
            {
              "id": 5820,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "20",
              "arabic_name": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
              "translated_name": "Mwenye nguvu na mwenye cheo kwa huyo Mwenye Kiti cha Enzi."
            },
            {
              "id": 5821,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "21",
              "arabic_name": "مُّطَاعٍ ثَمَّ أَمِينٍ",
              "translated_name": "Anayetiiwa, tena muaminifu."
            },
            {
              "id": 5822,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "22",
              "arabic_name": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
              "translated_name": "Na wala huyu mwenzenu hana wazimu."
            },
            {
              "id": 5823,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "23",
              "arabic_name": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
              "translated_name": "Na hakika yeye alimwona kwenye upeo wa macho ulio safi."
            },
            {
              "id": 5824,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "24",
              "arabic_name": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
              "translated_name": "Wala yeye si bahili kwa mambo ya ghaibu."
            },
            {
              "id": 5825,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "25",
              "arabic_name": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
              "translated_name": "Wala hii si kauli ya Shetani aliyelaaniwa."
            },
            {
              "id": 5826,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "26",
              "arabic_name": "فَأَيْنَ تَذْهَبُونَ",
              "translated_name": "Basi mnakwenda wapi?"
            },
            {
              "id": 5827,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "27",
              "arabic_name": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
              "translated_name": "Haikuwa hii ila ni ukumbusho kwa walimwengu wote."
            },
            {
              "id": 5828,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "28",
              "arabic_name": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
              "translated_name": "Kwa yule miongoni mwenu anayetaka kwenda sawa."
            },
            {
              "id": 5829,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "29",
              "arabic_name": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
              "translated_name": "Wala nyinyi hamtataka isipokuwa atake Mwenyezi Mungu Mola Mlezi wa walimwengu wote."
            }
          ],
          "page_arabic_ayah": "إِذَا ٱلشَّمْسُ كُوِّرَتْ (١)  وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ (٢)  وَإِذَا ٱلْجِبَالُ سُيِّرَتْ (٣)  وَإِذَا ٱلْعِشَارُ عُطِّلَتْ (٤)  وَإِذَا ٱلْوُحُوشُ حُشِرَتْ (٥)  وَإِذَا ٱلْبِحَارُ سُجِّرَتْ (٦)  وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ (٧)  وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ (٨)  بِأَىِّ ذَنۢبٍ قُتِلَتْ (٩)  وَإِذَا ٱلصُّحُفُ نُشِرَتْ (١٠)  وَإِذَا ٱلسَّمَآءُ كُشِطَتْ (١١)  وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ (١٢)  وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ (١٣)  عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ (١٤)  فَلَآ أُقْسِمُ بِٱلْخُنَّسِ (١٥)  ٱلْجَوَارِ ٱلْكُنَّسِ (١٦)  وَٱلَّيْلِ إِذَا عَسْعَسَ (١٧)  وَٱلصُّبْحِ إِذَا تَنَفَّسَ (١٨)  إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ (١٩)  ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ (٢٠)  مُّطَاعٍ ثَمَّ أَمِينٍ (٢١)  وَمَا صَاحِبُكُم بِمَجْنُونٍ (٢٢)  وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ (٢٣)  وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ (٢٤)  وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ (٢٥)  فَأَيْنَ تَذْهَبُونَ (٢٦)  إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ (٢٧)  لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ (٢٨)  وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ (٢٩)",
