              "arabic_name": "إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ",
              "translated_name": "जब आकाश फट जाएगा।"
            },
            {
              "id": 5831,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ",
              "translated_name": "तथा जब तारे झड़ जाएँगे।"
            },
            {
              "id": 5832,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",
              "translated_name": "और जब समुद्र बह निकलेंगे।"
            },
            {
              "id": 5833,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",
              "translated_name": "और जब क़बरें उलट दी जाएँगी।"
            },
            {
              "id": 5834,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ",
              "translated_name": "तब प्रत्येक प्राणी जान लेगा, जो उसने आगे भेजा और जो पीछे छोड़ा।[1]"
            },
            {
              "id": 5835,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",
              "translated_name": "ऐ इनसान! तुझे किस चीज़ ने तेरे उदार पालनहार से बहका दिया?"
            },
            {
              "id": 5836,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
              "translated_name": "जिसने तेरी रचना की, फिर तुझे ठीक ठाक किया, फिर तुझे संतुलित बनाया।"
            },
            {
              "id": 5837,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ",
              "translated_name": "जिस रूप में भी उसने चाहा, तुझे बना दिया।[2]"
            },
            {
              "id": 5838,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ",
              "translated_name": "हरगिज़ नहीं, बल्कि तुम बदले (के दिन) को झुठलाते हो।"
            },
            {
              "id": 5839,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ",
              "translated_name": "हालाँकि निःसंदेह तुमपर निगेहबान नियुक्त हैं।"
            },
            {
              "id": 5840,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "كِرَامًا كَـٰتِبِينَ",
              "translated_name": "जो सम्माननीय लिखने वाले हैं।"
            },
            {
              "id": 5841,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "يَعْلَمُونَ مَا تَفْعَلُونَ",
              "translated_name": "वे जानते हैं, जो तुम करते हो।[3]"
            },
            {
              "id": 5842,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
              "translated_name": "निःसंदेह नेक लोग बड़ी नेमत (आनंद) में होंगे।"
            },
            {
              "id": 5843,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ",
              "translated_name": "और निःसंदेह दुराचारी लोग जहन्नम में होंगे।"
            },
            {
              "id": 5844,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ",
              "translated_name": "वे उसमें बदले के दिन प्रवेश करेंगे।"
            },
            {
              "id": 5845,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ",
              "translated_name": "और वे उससे कभी ग़ायब होने वाले नहीं हैं।[4]"
            },
            {
              "id": 5846,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
              "translated_name": "और आप क्या जानें कि बदले का दिन क्या है?"
