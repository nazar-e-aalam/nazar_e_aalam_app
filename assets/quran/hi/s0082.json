              "id": 5848,
              "chapter_id": 82,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ",
              "translated_name": "जिस दिन कोई प्राणी किसी प्राणी के लिए किसी चीज़ का अधिकार न रखेगा और उस दिन आदेश केवल अल्लाह का होगा।[5]"
            }
          ],
