              "arabic_name": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
              "translated_name": "और रात की (क़सम), जब वह उस (सूरज) को ढाँप ले।"
            },
            {
              "id": 6048,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
              "translated_name": "और आकाश की तथा उसके निर्माण की (क़सम)।"
            },
            {
              "id": 6049,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
              "translated_name": "और धरती की तथा उसे बिछाने की (क़सम!)[1]"
            },
            {
              "id": 6050,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "وَنَفْسٍ وَمَا سَوَّىٰهَا",
              "translated_name": "और आत्मा की तथा उसके ठीक-ठाक बनाने की (क़सम)।"
            },
            {
              "id": 6051,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
              "translated_name": "फिर उसके दिल में उसकी बुराई और उसकी परहेज़गारी (की समझ) डाल दी।[2]"
            },
            {
              "id": 6052,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
              "translated_name": "निश्चय वह सफल हो गया, जिसने उसे पवित्र कर लिया।"
            },
            {
              "id": 6053,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
              "translated_name": "तथा निश्चय वह विफल हो गया, जिसने उसे (पापों में) दबा दिया।[3]"
            },
            {
              "id": 6054,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
              "translated_name": "समूद (की जाति) ने अपनी सरकशी के कारण झुठलाया।"
            },
            {
              "id": 6055,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
              "translated_name": "जब उसका सबसे दुष्ट व्यक्ति उठ खड़ा हुआ।"
            },
            {
              "id": 6056,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا",
              "translated_name": "तो अल्लाह के रसूल ने उनसे कहा : अल्लाह की ऊँटनी और उसके पीने की बारी का ध्यान रखो।"
            },
            {
              "id": 6057,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
              "translated_name": "परंतु उन्होंने उसे झुठलाया और उस (ऊँटनी) की कूँचें काट दीं, तो उनके पालनहार ने उनके गुनाह के कारण उन्हें पीस कर विनष्ट कर दिया और उन्हें मटियामेट कर दिया।"
