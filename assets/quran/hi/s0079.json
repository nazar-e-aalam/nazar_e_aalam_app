            {
              "id": 5713,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "1",
              "arabic_name": "وَٱلنَّـٰزِعَـٰتِ غَرْقًا",
              "translated_name": "क़सम है उन फ़रिश्तों की, जो डूबकर सख़्ती से (प्राण) खींचने वाले हैं!"
            },
            {
              "id": 5714,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "وَٱلنَّـٰشِطَـٰتِ نَشْطًا",
              "translated_name": "और क़सम है उन फ़रिश्तों की, जो आसानी से (प्राण) निकालने वाले हैं!"
            },
            {
              "id": 5715,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "وَٱلسَّـٰبِحَـٰتِ سَبْحًا",
              "translated_name": "और क़सम है उन फ़रिश्तों की, जो तेज़ी से तैरने वाले हैं!"
            },
            {
              "id": 5716,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "فَٱلسَّـٰبِقَـٰتِ سَبْقًا",
              "translated_name": "फिर क़सम है उन फ़रिश्तों की, जो दौड़कर आगे बढ़ने वाले हैं!"
            },
            {
              "id": 5717,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "فَٱلْمُدَبِّرَٰتِ أَمْرًا",
              "translated_name": "फिर क़सम है उन फ़रिश्तों की, जो आदेश को क्रियान्वित करने वाले हैं![1]"
            },
            {
              "id": 5718,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
              "translated_name": "जिस दिन काँपने वाली (अर्थात् धरती) काँप उठेगी।"
            },
            {
              "id": 5719,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "تَتْبَعُهَا ٱلرَّادِفَةُ",
              "translated_name": "उसके पीछे आएगी पीछे आने वाली।"
            },
            {
              "id": 5720,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",
              "translated_name": "उस दिन कई दिल धड़कने वाले होंगे।"
            },
            {
              "id": 5721,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "أَبْصَـٰرُهَا خَـٰشِعَةٌ",
              "translated_name": "उनकी आँखें झुकी हुई होंगी।"
            },
            {
              "id": 5722,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
              "translated_name": "वे कहते हैं : क्या हम निश्चय पहली स्थिति में लौटाए जाने वाले हैं?"
            },
            {
              "id": 5723,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً",
              "translated_name": "क्या जब हम सड़ी-गली हड्डियाँ हो जाएँगे?"
            },
            {
              "id": 5724,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
              "translated_name": "उन्होंने कहा : यह तो उस समय घाटे वाला लौटना होगा।"
            },
            {
              "id": 5725,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ",
              "translated_name": "वह तो केवल एक डाँट होगी।"
            },
            {
              "id": 5726,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
              "translated_name": "फिर एकाएक वे (जीवित होकर) धरती के ऊपर होंगे।"
            },
            {
              "id": 5727,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
              "translated_name": "(ऐ नबी!) क्या आपके पास मूसा की बात पहुँची है?[2]"
            }
          ],
          "page_arabic_ayah": "وَٱلنَّـٰزِعَـٰتِ غَرْقًا (١)  وَٱلنَّـٰشِطَـٰتِ نَشْطًا (٢)  وَٱلسَّـٰبِحَـٰتِ سَبْحًا (٣)  فَٱلسَّـٰبِقَـٰتِ سَبْقًا (٤)  فَٱلْمُدَبِّرَٰتِ أَمْرًا (٥)  يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ (٦)  تَتْبَعُهَا ٱلرَّادِفَةُ (٧)  قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ (٨)  أَبْصَـٰرُهَا خَـٰشِعَةٌ (٩)  يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ (١٠)  أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً (١١)  قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ (١٢)  فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ (١٣)  فَإِذَا هُم بِٱلسَّاهِرَةِ (١٤)  هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ (١٥)",
          "is_read": false
        },
        {
          "eng_page_number": 584,
          "page_number": "584",
          "page_key": 1,
          "page_verses": [
            {
              "id": 5728,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
              "translated_name": "जब उसके पालनहार ने उसे पवित्र घाटी 'तुवा' में पुकारा।"
            },
            {
              "id": 5729,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
              "translated_name": "फ़िरऔन के पास जाओ, निश्चय वह हद से बढ़ गया है।"
            },
            {
              "id": 5730,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
              "translated_name": "फिर उससे कहो : क्या तुझे इस बात की इच्छा है कि तू पवित्र हो जाए?"
            },
            {
              "id": 5731,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
              "translated_name": "और मैं तेरे पालनहार की ओर तेरा मार्गदर्शन करूँ, तो तू डर जाए?"
            },
            {
              "id": 5732,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "20",
              "arabic_name": "فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ",
              "translated_name": "फिर उसे सबसे बड़ी निशानी (चमत्कार) दिखाई।"
            },
            {
              "id": 5733,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "21",
              "arabic_name": "فَكَذَّبَ وَعَصَىٰ",
              "translated_name": "तो उसने झुठला दिया और अवज्ञा की।"
            },
            {
              "id": 5734,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "22",
              "arabic_name": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
              "translated_name": "फिर वह पलटा (मूसा अलैहिस्सलाम के विरोध का) प्रयास करते हुए।"
            },
            {
              "id": 5735,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "23",
              "arabic_name": "فَحَشَرَ فَنَادَىٰ",
              "translated_name": "फिर उसने (लोगों को) एकत्रित किया। फिर पुकारा।"
            },
            {
              "id": 5736,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "24",
              "arabic_name": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
              "translated_name": "तो उसने कहा : मैं तुम्हारा सबसे ऊँचा पालनहार हूँ।"
            },
            {
              "id": 5737,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "25",
              "arabic_name": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ",
              "translated_name": "तो अल्लाह ने उसे आख़िरत और दुनिया की यातना में पकड़ लिया।"
            },
            {
              "id": 5738,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "26",
              "arabic_name": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ",
              "translated_name": "निःसंदेह इसमें उस व्यक्ति के लिए शिक्षा है, जो डरता है।"
            },
            {
              "id": 5739,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "27",
              "arabic_name": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
              "translated_name": "क्या तुम्हें पैदा करना अधिक कठिन है या आकाश को, जिसे उसने बनाया।[3]"
            },
            {
              "id": 5740,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "28",
              "arabic_name": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
              "translated_name": "उसकी छत को ऊँचा किया, फिर उसे बराबर किया।"
            },
            {
              "id": 5741,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "29",
              "arabic_name": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
              "translated_name": "और उसकी रात को अंधेरा कर दिया तथा उसके दिन के प्रकाश को प्रकट कर दिया।"
            },
            {
              "id": 5742,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "30",
              "arabic_name": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
              "translated_name": "और उसके बाद धरती को बिछाया।"
            },
            {
              "id": 5743,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "31",
              "arabic_name": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
              "translated_name": "उससे उसका पानी और उसका चारा निकाला।"
            },
            {
              "id": 5744,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "32",
              "arabic_name": "وَٱلْجِبَالَ أَرْسَىٰهَا",
              "translated_name": "और पर्वतों को गाड़ दिया।"
            },
            {
              "id": 5745,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "33",
              "arabic_name": "مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
              "translated_name": "तुम्हारे तथा तुम्हारे पशुओं के लाभ के लिए।"
            },
            {
              "id": 5746,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "34",
              "arabic_name": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ",
              "translated_name": "फिर जब बड़ी आपदा (क़ियामत) आ जाएगी।[4]"
            },
            {
              "id": 5747,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "35",
              "arabic_name": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ",
              "translated_name": "जिस दिन इनसान अपने किए को याद करेगा।[5]"
            },
            {
              "id": 5748,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "36",
              "arabic_name": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ",
              "translated_name": "और देखने वाले के लिए जहन्नम सामने कर दी जाएगी।"
            },
            {
              "id": 5749,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "37",
              "arabic_name": "فَأَمَّا مَن طَغَىٰ",
              "translated_name": "तो जो व्यक्ति हद से बढ़ गया।"
            },
            {
              "id": 5750,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "38",
              "arabic_name": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
              "translated_name": "और उसने सांसारिक जीवन को वरीयता दी।"
            },
            {
              "id": 5751,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "39",
              "arabic_name": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
              "translated_name": "तो निःसंदेह जहन्नम ही उसका ठिकाना है।"
            },
            {
              "id": 5752,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "40",
              "arabic_name": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
              "translated_name": "लेकिन जो अपने पालनहार के समक्ष खड़ा होने से डर गया तथा अपने मन को बुरी इच्छा से रोक लिया।"
            },
            {
              "id": 5753,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "41",
              "arabic_name": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ",
              "translated_name": "तो निःसंदेह जन्नत ही उसका ठिकाना है।"
            },
            {
              "id": 5754,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "42",
              "arabic_name": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا",
              "translated_name": "वे आपसे क़ियामत के बारे में पूछते हैं कि वह कब घटित होगी?[6]"
            },
            {
              "id": 5755,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "43",
              "arabic_name": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ",
              "translated_name": "आपका उसके उल्लेख करने से क्या संबंध है?"
            },
            {
              "id": 5756,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "44",
              "arabic_name": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ",
              "translated_name": "उस (के ज्ञान) की अंतिमता तुम्हारे पालनहार ही की ओर है।"
            },
            {
              "id": 5757,
