      "chapter_info": [
        {
          "eng_page_number": 585,
          "page_number": "585",
          "page_key": 0,
          "page_verses": [
            {
              "id": 5759,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "1",
              "arabic_name": "عَبَسَ وَتَوَلَّىٰٓ",
              "translated_name": "उस (नबी) ने त्योरी चढ़ाई और मुँह फेर लिया।"
            },
            {
              "id": 5760,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
              "translated_name": "इस कारण कि उनके पास अंधा आया।"
            },
            {
              "id": 5761,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
              "translated_name": "और आपको क्या मालूम शायद वह पवित्रता प्राप्त कर ले।"
            },
            {
              "id": 5762,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
              "translated_name": "या नसीहत ग्रहण करे, तो वह नसीहत उसे लाभ दे।"
            },
            {
              "id": 5763,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
              "translated_name": "लेकिन जो बेपरवाह हो गया।"
            },
            {
              "id": 5764,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
              "translated_name": "तो आप उसके पीछे पड़ रहे हैं।"
            },
            {
              "id": 5765,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
              "translated_name": "हालाँकि आपपर कोई दोष नहीं कि वह पवित्रता ग्रहण नहीं करता।"
            },
            {
              "id": 5766,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
              "translated_name": "लेकिन जो व्यक्ति आपके पास दौड़ता हुआ आया।"
            },
            {
              "id": 5767,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "وَهُوَ يَخْشَىٰ",
              "translated_name": "और वह डर (भी) रहा है।"
            },
            {
              "id": 5768,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
              "translated_name": "तो आप उसकी ओर ध्यान नहीं देते।[1]"
            },
            {
              "id": 5769,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "كَلَّآ إِنَّهَا تَذْكِرَةٌ",
              "translated_name": "ऐसा हरगिज़ नहीं चाहिए, यह (क़ुरआन) तो एक उपदेश है।"
            },
            {
              "id": 5770,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "فَمَن شَآءَ ذَكَرَهُۥ",
              "translated_name": "अतः जो चाहे, उसे याद करे।"
            },
            {
              "id": 5771,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "فِى صُحُفٍ مُّكَرَّمَةٍ",
              "translated_name": "(यह क़ुरआन) सम्मानित सहीफ़ों (ग्रंथों) में है।"
            },
            {
              "id": 5772,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ",
              "translated_name": "जो उच्च स्थान वाले तथा पवित्र हैं।"
            },
            {
              "id": 5773,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "بِأَيْدِى سَفَرَةٍ",
              "translated_name": "ऐसे लिखने वालों (फ़रिश्तों) के हाथों में हैं।"
            },
            {
              "id": 5774,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "كِرَامٍۭ بَرَرَةٍ",
              "translated_name": "जो माननीय और नेक हैं।[2]"
            },
            {
              "id": 5775,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ",
              "translated_name": "सर्वनाश हो मनुष्य का, वह कितना कृतघ्न (नाशुक्रा) है।"
            },
            {
              "id": 5776,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
              "translated_name": "(अल्लाह ने) उसे किस चीज़ से पैदा किया?"
            },
            {
              "id": 5777,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
              "translated_name": "एक नुत्फ़े (वीर्य) से उसे पैदा किया, फिर विभिन्न चरणों में उसकी रचना की।"
            },
            {
              "id": 5778,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "20",
              "arabic_name": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
              "translated_name": "फिर उसके लिए रास्ता आसान कर दिया।"
            },
            {
              "id": 5779,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "21",
              "arabic_name": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
              "translated_name": "फिर उसे मृत्यु दी, फिर उसे क़ब्र में रखवाया।"
            },
            {
              "id": 5780,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "22",
              "arabic_name": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
              "translated_name": "फिर जब वह चाहेगा, उसे उठाएगा।"
            },
            {
              "id": 5781,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "23",
              "arabic_name": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
              "translated_name": "हरगिज़ नहीं, अभी तक उसने उसे पूरा नहीं किया, जिसका अल्लाह ने उसे आदेश दिया था।[3]"
            },
            {
              "id": 5782,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "24",
              "arabic_name": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ",
              "translated_name": "अतः इनसान को चाहिए कि अपने भोजन को देखे।"
            },
            {
              "id": 5783,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "25",
              "arabic_name": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا",
              "translated_name": "कि हमने ख़ूब पानी बरसाया।"
            },
            {
              "id": 5784,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "26",
              "arabic_name": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا",
              "translated_name": "फिर हमने धरती को विशेष रूप से फाड़ा।"
            },
            {
              "id": 5785,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "27",
              "arabic_name": "فَأَنۢبَتْنَا فِيهَا حَبًّا",
              "translated_name": "फिर हमने उसमें अनाज उगाया।"
            },
            {
              "id": 5786,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "28",
              "arabic_name": "وَعِنَبًا وَقَضْبًا",
              "translated_name": "तथा अंगूर और (मवेशियों का) चारा।"
            },
            {
              "id": 5787,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "29",
              "arabic_name": "وَزَيْتُونًا وَنَخْلًا",
              "translated_name": "तथा ज़ैतून और खजूर के पेड़।"
            },
            {
              "id": 5788,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "30",
              "arabic_name": "وَحَدَآئِقَ غُلْبًا",
              "translated_name": "तथा घने बाग़।"
            },
            {
              "id": 5789,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "31",
              "arabic_name": "وَفَـٰكِهَةً وَأَبًّا",
              "translated_name": "तथा फल और चारा।"
            },
            {
              "id": 5790,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "32",
              "arabic_name": "مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
              "translated_name": "तुम्हारे लिए तथा तुम्हारे पशुओं के लिए जीवन-सामग्री के रूप में।[4]"
            },
            {
              "id": 5791,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "33",
              "arabic_name": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
              "translated_name": "तो जब कानों को बहरा कर देने वाली प्रचंड आवाज़ (क़ियामत) आ जाएगी।"
            },
            {
              "id": 5792,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "34",
              "arabic_name": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
              "translated_name": "जिस दिन इनसान अपने भाई से भागेगा।"
            },
            {
              "id": 5793,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "35",
              "arabic_name": "وَأُمِّهِۦ وَأَبِيهِ",
              "translated_name": "तथा अपनी माता और अपने पिता (से)।"
            },
            {
              "id": 5794,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "36",
              "arabic_name": "وَصَـٰحِبَتِهِۦ وَبَنِيهِ",
              "translated_name": "तथा अपनी पत्नी और अपने बेटों से।"
            },
            {
              "id": 5795,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "37",
              "arabic_name": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ",
              "translated_name": "उस दिन उनमें से प्रत्येक व्यक्ति की ऐसी स्थिति होगी, जो उसे (दूसरों से) बेपरवाह कर देगी।"
            },
            {
              "id": 5796,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "38",
              "arabic_name": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ",
              "translated_name": "उस दिन कुछ चेहरे रौशन होंगे।"
            },
            {
              "id": 5797,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "39",
              "arabic_name": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ",
              "translated_name": "हँसते हुए, प्रसन्न होंगे।"
            },
            {
              "id": 5798,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "40",
              "arabic_name": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ",
              "translated_name": "तथा कुछ चेहरों उस दिन धूल से ग्रस्त होंगे।"
            },
            {
              "id": 5799,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "41",
              "arabic_name": "تَرْهَقُهَا قَتَرَةٌ",
              "translated_name": "उनपर कालिमा छाई होगी।"
            },
            {
              "id": 5800,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "42",
              "arabic_name": "أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
              "translated_name": "वही काफ़िर और कुकर्मी लोग हैं।[5]"
            }
          ],
          "page_arabic_ayah": "عَبَسَ وَتَوَلَّىٰٓ (١)  أَن جَآءَهُ ٱلْأَعْمَىٰ (٢)  وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ (٣)  أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ (٤)  أَمَّا مَنِ ٱسْتَغْنَىٰ (٥)  فَأَنتَ لَهُۥ تَصَدَّىٰ (٦)  وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ (٧)  وَأَمَّا مَن جَآءَكَ يَسْعَىٰ (٨)  وَهُوَ يَخْشَىٰ (٩)  فَأَنتَ عَنْهُ تَلَهَّىٰ (١٠)  كَلَّآ إِنَّهَا تَذْكِرَةٌ (١١)  فَمَن شَآءَ ذَكَرَهُۥ (١٢)  فِى صُحُفٍ مُّكَرَّمَةٍ (١٣)  مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ (١٤)  بِأَيْدِى سَفَرَةٍ (١٥)  كِرَامٍۭ بَرَرَةٍ (١٦)  قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ (١٧)  مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ (١٨)  مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ (١٩)  ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ (٢٠)  ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ (٢١)  ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ (٢٢)  كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ (٢٣)  فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ (٢٤)  أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا (٢٥)  ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا (٢٦)  فَأَنۢبَتْنَا فِيهَا حَبًّا (٢٧)  وَعِنَبًا وَقَضْبًا (٢٨)  وَزَيْتُونًا وَنَخْلًا (٢٩)  وَحَدَآئِقَ غُلْبًا (٣٠)  وَفَـٰكِهَةً وَأَبًّا (٣١)  مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ (٣٢)  فَإِذَا جَآءَتِ ٱلصَّآخَّةُ (٣٣)  يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ (٣٤)  وَأُمِّهِۦ وَأَبِيهِ (٣٥)  وَصَـٰحِبَتِهِۦ وَبَنِيهِ (٣٦)  لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ (٣٧)  وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ (٣٨)  ضَاحِكَةٌ مُّسْتَبْشِرَةٌ (٣٩)  وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ (٤٠)  تَرْهَقُهَا قَتَرَةٌ (٤١)  أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ (٤٢)",
          "is_read": false
        }
      ]
    }
  }
