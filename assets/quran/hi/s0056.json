            {
              "id": 4987,
              "chapter_id": 56,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",
              "translated_name": "तो दाहिने हाथ वाले, क्या ही अच्छे हैं दाहिने हाथ वाले![2]"
