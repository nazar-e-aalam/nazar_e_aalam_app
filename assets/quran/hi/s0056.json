            },
            {
              "id": 4986,
              "chapter_id": 56,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "وَكُنتُمْ أَزْوَٰجًا ثَلَـٰثَةً",
              "translated_name": "और तुम तीन प्रकार के लोग हो जाओगे।"
