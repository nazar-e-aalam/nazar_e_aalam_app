            {
              "id": 4989,
              "chapter_id": 56,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ",
              "translated_name": "और जो पहल करने वाले हैं, वही आगे बढ़ने वाले हैं।"
