              "chapter_id": 56,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا",
              "translated_name": "और पर्वत ख़ूब चूर्ण-विचूर्ण कर दिए जाएँगे।"
