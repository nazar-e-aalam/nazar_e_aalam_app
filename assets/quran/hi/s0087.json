              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ",
              "translated_name": "फिर उसे (सुखाकर) काले रंग का कूड़ा बना दिया।[2]"
            },
            {
              "id": 5954,
              "chapter_id": 87,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
              "translated_name": "(ऐ नबी!) हम तुम्हें ऐसा पढ़ाएँगे कि तुम नहीं भूलोगे।"
            },
            {
              "id": 5955,
              "chapter_id": 87,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ",
              "translated_name": "परन्तु जो अल्लाह चाहे। निश्चय ही वह खुली बात को जानता है और उस बात को भी जो छिपी हुई है।"
            },
            {
              "id": 5956,
              "chapter_id": 87,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
              "translated_name": "और हम तुम्हारे लिए सरल मार्ग आसान कर देंगे।[3]"
            },
            {
              "id": 5957,
              "chapter_id": 87,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ",
              "translated_name": "तो आप नसीहत करते रहें। अगर नसीहत करना लाभदायक हो।"
            },
            {
              "id": 5958,
              "chapter_id": 87,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "سَيَذَّكَّرُ مَن يَخْشَىٰ",
              "translated_name": "वह व्यक्ति उपदेश ग्रहण करेगा, जो डरता है।"
            },
            {
              "id": 5959,
              "chapter_id": 87,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى",
              "translated_name": "और उससे दूर रहेगा, जो सबसे बड़ा अभागा है।"
            },
            {
              "id": 5960,
              "chapter_id": 87,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ",
              "translated_name": "जो सबसे बड़ी आग में प्रवेश करेगा।"
            },
            {
              "id": 5961,
              "chapter_id": 87,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",
              "translated_name": "फिर वह उसमें न मरेगा, न जिएगा।[4]"
