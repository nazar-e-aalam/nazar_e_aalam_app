              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "39",
              "arabic_name": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
              "translated_name": "फिर उसने उससे दो प्रकार : नर और मादा बनाए।"
