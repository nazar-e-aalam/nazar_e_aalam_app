              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "31",
              "arabic_name": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
              "translated_name": "तो न उसने (सत्य को) माना और न नमाज़ पढ़ी।"
            },
            {
              "id": 5583,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
