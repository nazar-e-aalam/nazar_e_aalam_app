              "arabic_name": "لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ",
              "translated_name": "मैं क़सम खाता हूँ क़ियामत के दिन[1] की।"
            },
            {
              "id": 5553,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
              "translated_name": "तथा मैं क़सम खाता हूँ निंदा[2] करने वाली अंतरात्मा की।"
            },
            {
              "id": 5554,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
              "translated_name": "क्या इनसान समझता है कि हम कभी उसकी हड्डियों को एकत्र नहीं करेंगे?"
            },
            {
              "id": 5555,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
              "translated_name": "क्यों नहीं? हम इस बता का भी सामर्थ्य रखते हैं कि उसकी उंगलियों की पोर-पोर सीधी कर दें।"
            },
            {
              "id": 5556,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ",
              "translated_name": "बल्कि मनुष्य चाहता है कि अपने आगे भी[3] गुनाह करता रहे।"
            },
            {
              "id": 5557,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ",
              "translated_name": "वह पूछता है कि क़ियामत का दिन कब होगा?"
            },
            {
              "id": 5558,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
              "translated_name": "तो जब आँख चौंधिया जाएगी।"
            },
            {
              "id": 5559,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "وَخَسَفَ ٱلْقَمَرُ",
              "translated_name": "और चाँद को ग्रहण लग जाएगा।"
            },
            {
              "id": 5560,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
              "translated_name": "और सूर्य और चाँद एकत्र[4] कर दिए जाएँगे।"
            },
            {
              "id": 5561,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
              "translated_name": "उस दिन मनुष्य कहेगा कि भागने का स्थान कहाँ है?"
            },
            {
              "id": 5562,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "كَلَّا لَا وَزَرَ",
              "translated_name": "कदापि नहीं, शरण लेने का स्थान कोई नहीं।"
            },
            {
              "id": 5563,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ",
              "translated_name": "उस दिन तेरे पालनहार ही की ओर लौटकर जाना है।"
            },
            {
              "id": 5564,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
              "translated_name": "उस दिन इनसान को बताया जाएगा जो उसने आगे भेजा और जो पीछे छोड़ा।[5]"
            },
            {
              "id": 5565,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ",
              "translated_name": "बल्कि इनसान स्वयं अपने विरुद्ध गवाह[6] है।"
            },
            {
              "id": 5566,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
              "translated_name": "अगरचे वह अपने बहाने पेश करे।"
            },
            {
              "id": 5567,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
              "translated_name": "(ऐ नबी!) आप इसके साथ अपनी ज़ुबान न हिलाएँ[7], ताकि इसे शीघ्र याद कर लें।"
            },
            {
              "id": 5568,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
              "translated_name": "निःसंदेह उसको एकत्र करना और (आपका) उसे पढ़ना हमारे ज़िम्मे है।"
            },
            {
              "id": 5569,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
              "translated_name": "अतः जब हम उसे पढ़ लें, तो आप उसके पठन का अनुसरण करें।"
            },
            {
              "id": 5570,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ",
              "translated_name": "फिर निःसंदेह उसे स्पषट करना हमारे ही ज़िम्मे है।"
            }
          ],
          "page_arabic_ayah": "لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ (١)  وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ (٢)  أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ (٣)  بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ (٤)  بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ (٥)  يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ (٦)  فَإِذَا بَرِقَ ٱلْبَصَرُ (٧)  وَخَسَفَ ٱلْقَمَرُ (٨)  وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ (٩)  يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ (١٠)  كَلَّا لَا وَزَرَ (١١)  إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ (١٢)  يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ (١٣)  بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ (١٤)  وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ (١٥)  لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ (١٦)  إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ (١٧)  فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ (١٨)  ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ (١٩)",
