            },
            {
              "id": 5588,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "37",
              "arabic_name": "أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ",
