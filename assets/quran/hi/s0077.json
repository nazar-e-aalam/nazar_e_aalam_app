          "page_verses": [
            {
              "id": 5642,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "20",
              "arabic_name": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ",
              "translated_name": "क्या हमने तुम्हें एक तुच्छ पानी से पैदा नहीं किया?"
            },
            {
              "id": 5643,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "21",
              "arabic_name": "فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ",
              "translated_name": "फिर हमने उसे एक सुरक्षित ठिकाने में रखा।"
            },
            {
              "id": 5644,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "22",
              "arabic_name": "إِلَىٰ قَدَرٍ مَّعْلُومٍ",
              "translated_name": "एक ज्ञात अवधि तक।[7]"
            },
            {
              "id": 5645,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "23",
              "arabic_name": "فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ",
              "translated_name": "फिर हमने अनुमान[8] लगाया, तो हम क्या ही अच्छा अनुमान लगाने वाले हैं।"
            },
            {
              "id": 5646,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "24",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "उस दिन झुठलाने वालों के लिए बड़ा विनाश है।"
            },
            {
              "id": 5647,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "25",
              "arabic_name": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
              "translated_name": "क्या हमने धरती को समेटने[9] वाली नहीं बनाया?"
            },
            {
              "id": 5648,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "26",
              "arabic_name": "أَحْيَآءً وَأَمْوَٰتًا",
              "translated_name": "जीवित और मृत लोगों को।"
            },
            {
              "id": 5649,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "27",
              "arabic_name": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا",
              "translated_name": "तथा हमने उसमें ऊँचे पर्वत बनाए और हमने तुम्हें मीठा पानी पिलाया।"
            },
            {
              "id": 5650,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "28",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "उस दिन झुठलाने वालों के लिए बड़ा विनाश है।"
            },
            {
              "id": 5651,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "29",
              "arabic_name": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
              "translated_name": "(कहा जाएगा :) उस चीज़ की ओर चलो, जिसे तुम झुठलाते थे।"
            },
            {
              "id": 5652,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "30",
              "arabic_name": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ",
              "translated_name": "एक छाया[10] की ओर चलो, जो तीन शाखाओं वाली है।"
            },
            {
              "id": 5653,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "31",
              "arabic_name": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
              "translated_name": "जो न छाया देगी और न ज्वाला से बचाएगी।"
            },
            {
              "id": 5654,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "32",
              "arabic_name": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ",
              "translated_name": "निःसंदेह वह (आग) भवन के समान चिंगारियाँ फेंकेगी।"
            },
            {
              "id": 5655,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "33",
              "arabic_name": "كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ",
              "translated_name": "जैसे वे पीले ऊँट हों।"
            },
            {
              "id": 5656,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "34",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "उस दिन झुठलाने वालों के लिए बड़ा विनाश है।"
            },
            {
              "id": 5657,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "35",
              "arabic_name": "هَـٰذَا يَوْمُ لَا يَنطِقُونَ",
              "translated_name": "यह वह दिन है कि वे बोल[11] नहीं सकेंगे।"
            },
            {
              "id": 5658,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "36",
              "arabic_name": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ",
              "translated_name": "और न उन्हें अनुमति दी जाएगी कि वे उज़्र (कारण) पेश करें।"
            },
            {
              "id": 5659,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "37",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "उस दिन झुठलाने वालों के लिए बड़ा विनाश है।"
            },
            {
              "id": 5660,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "38",
              "arabic_name": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ",
              "translated_name": "यह निर्णय का दिन है। हमने तुम्हें और पहलों को एकत्र कर दिया है।"
            },
            {
              "id": 5661,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "39",
              "arabic_name": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ",
              "translated_name": "तो यदि तुम्हारे पास कोई चाल[12] हो, तो मेरे विरुद्ध चलो।"
            },
            {
              "id": 5662,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "40",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "उस दिन झुठलाने वालों के लिए बड़ा विनाश है।"
            },
            {
              "id": 5663,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "41",
              "arabic_name": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ",
              "translated_name": "निश्चय डरने वाले लोग छाँवों तथा स्रोतों में होंगे।"
            },
            {
              "id": 5664,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "42",
              "arabic_name": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ",
              "translated_name": "तथा फलों में, जिसमें से वे चाहेंगे।"
            },
            {
              "id": 5665,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "43",
              "arabic_name": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ",
              "translated_name": "(तथा उनसे कहा जाएगा :) मज़े से खाओ और पियो, उसके बदले जो तुम किया करते थे।"
            },
            {
              "id": 5666,
              "chapter_id": 77,
