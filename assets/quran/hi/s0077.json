          "page_verses": [
            {
              "id": 5623,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "1",
              "arabic_name": "وَٱلْمُرْسَلَـٰتِ عُرْفًا",
              "translated_name": "क़सम है उन हवाओं की जो निरंतर भेजी जाती हैं!"
            },
            {
              "id": 5624,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "فَٱلْعَـٰصِفَـٰتِ عَصْفًا",
              "translated_name": "फिर बहुत तेज़ चलने वाली हवाओं की क़सम!"
            },
            {
              "id": 5625,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "وَٱلنَّـٰشِرَٰتِ نَشْرًا",
              "translated_name": "और बादलों को फैलाने वाली हवाओं[1] की क़सम!"
            },
            {
              "id": 5626,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "فَٱلْفَـٰرِقَـٰتِ فَرْقًا",
              "translated_name": "फिर सत्य और असत्य के बीच अंतर करने वाली चीज़[2] के साथ उतरने वाले फ़रिश्तों की क़सम!"
            },
            {
              "id": 5627,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "فَٱلْمُلْقِيَـٰتِ ذِكْرًا",
              "translated_name": "फिर वह़्य[3] लेकर उतरने वाले फ़रिश्तों की क़सम!"
            },
            {
              "id": 5628,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "عُذْرًا أَوْ نُذْرًا",
              "translated_name": "उज़्र (बहाना) समाप्त करने या डराने[4] के लिए।"
            },
            {
              "id": 5629,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ",
              "translated_name": "निःसंदेह तुमसे जिस चीज़ का वादा किया जाता है, निश्चय वह होकर रहने वाली है।"
            },
            {
              "id": 5630,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
              "translated_name": "फिर जब तारे मिटा दिए जाएँगे।"
            },
            {
              "id": 5631,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
              "translated_name": "और जब आकाश फाड़ दिया जाएगा।"
            },
            {
              "id": 5632,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
              "translated_name": "और जब पर्वत उड़ा दिए जाएँगे।"
            },
            {
              "id": 5633,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
              "translated_name": "और जब रसूलों को निर्धारित समय पर एकत्र किया जाएगा।[5]"
            },
            {
              "id": 5634,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "لِأَىِّ يَوْمٍ أُجِّلَتْ",
              "translated_name": "किस दिन के लिए वे विलंबित किए गए हैं?"
            },
            {
              "id": 5635,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "لِيَوْمِ ٱلْفَصْلِ",
              "translated_name": "निर्णय के दिन के लिए।"
            },
            {
              "id": 5636,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
              "translated_name": "और आपको किस चीज़ ने अवगत कराया कि निर्णय का दिन क्या है?"
            },
            {
              "id": 5637,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "उस दिन झुठलाने वालों के लिए बड़ा विनाश है।"
            },
            {
              "id": 5638,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ",
              "translated_name": "क्या हमने पहलों को विनष्ट नहीं किया?"
            },
            {
              "id": 5639,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ",
              "translated_name": "फिर हम उनके पीछे बाद वालों को भेजेंगे।[6]"
            },
            {
              "id": 5640,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
              "translated_name": "हम अपराधियों के साथ ऐसा ही करते हैं।"
            },
            {
              "id": 5641,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "उस दिन झुठलाने वालों के लिए बड़ा विनाश है।"
            }
          ],
          "page_arabic_ayah": "وَٱلْمُرْسَلَـٰتِ عُرْفًا (١)  فَٱلْعَـٰصِفَـٰتِ عَصْفًا (٢)  وَٱلنَّـٰشِرَٰتِ نَشْرًا (٣)  فَٱلْفَـٰرِقَـٰتِ فَرْقًا (٤)  فَٱلْمُلْقِيَـٰتِ ذِكْرًا (٥)  عُذْرًا أَوْ نُذْرًا (٦)  إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ (٧)  فَإِذَا ٱلنُّجُومُ طُمِسَتْ (٨)  وَإِذَا ٱلسَّمَآءُ فُرِجَتْ (٩)  وَإِذَا ٱلْجِبَالُ نُسِفَتْ (١٠)  وَإِذَا ٱلرُّسُلُ أُقِّتَتْ (١١)  لِأَىِّ يَوْمٍ أُجِّلَتْ (١٢)  لِيَوْمِ ٱلْفَصْلِ (١٣)  وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ (١٤)  وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ (١٥)  أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ (١٦)  ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ (١٧)  كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ (١٨)  وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ (١٩)",
          "is_read": false
