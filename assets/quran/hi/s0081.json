            {
              "id": 5801,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "1",
              "arabic_name": "إِذَا ٱلشَّمْسُ كُوِّرَتْ",
              "translated_name": "जब सूर्य लपेट दिया जाएगा।"
            },
            {
              "id": 5802,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
              "translated_name": "और जब सितारे प्रकाश रहित हो जाएँगे।"
            },
            {
              "id": 5803,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
              "translated_name": "और जब पर्वत चलाए जाएँगे।"
            },
            {
              "id": 5804,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
              "translated_name": "और जब गाभिन ऊँटनियाँ छोड़ दी जाएँगी।"
            },
            {
              "id": 5805,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
              "translated_name": "और जब जंगली जानवर एकत्रित किए जाएँगे।"
            },
            {
              "id": 5806,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
              "translated_name": "और जब सागर भड़काए जाएँगे।[1]"
            },
            {
              "id": 5807,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
              "translated_name": "और जब प्राण मिला दिए जाएँगे।"
            },
            {
              "id": 5808,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
              "translated_name": "और जब जीवित गाड़ी गई लड़की से पूछा जाएगा।"
            },
            {
              "id": 5809,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
              "translated_name": "कि वह किस अपराध के कारण मारी गई?"
            },
            {
              "id": 5810,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
              "translated_name": "तथा जब कर्मपत्र (आमाल नामे) फैला दिए जाएँगे।"
            },
            {
              "id": 5811,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
              "translated_name": "और जब आकाश उधेड़ दिया जाएगा।"
            },
            {
              "id": 5812,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
              "translated_name": "और जब जहन्नम दहकाई जाएगी।"
            },
            {
              "id": 5813,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
              "translated_name": "और जब जन्नत क़रीब लाई जाएगी।"
            },
            {
              "id": 5814,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
              "translated_name": "तो प्रत्येक प्राणी जान लेगा कि वह क्या लेकर आया है।[2]"
            },
            {
              "id": 5815,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
              "translated_name": "मैं क़सम खाता हूँ पीछे हटने वाले सितारों की।"
            },
            {
              "id": 5816,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "ٱلْجَوَارِ ٱلْكُنَّسِ",
              "translated_name": "चलने वाले, छिप जाने वाले तारों की।"
            },
            {
              "id": 5817,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
              "translated_name": "और रात की (क़सम), जब वह आती और जाती है।"
            },
            {
              "id": 5818,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
              "translated_name": "तथा सुबह की, जब वह रौशन होने लगे।"
            },
            {
              "id": 5819,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
              "translated_name": "निःसंदेह यह (क़ुरआन) एक आदरणीय संदेशवाहक की लाई हुई वाणी है।"
            },
            {
              "id": 5820,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "20",
              "arabic_name": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
              "translated_name": "जो शक्तिशाली है, अर्श (सिंहासन) वाले के पास उच्च पद वाला है।"
            },
            {
              "id": 5821,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "21",
              "arabic_name": "مُّطَاعٍ ثَمَّ أَمِينٍ",
              "translated_name": "उसकी वहाँ (आसमानों में) बात मानी जाती है और बड़ा विश्वसनीय है।[3]"
            },
            {
              "id": 5822,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "22",
              "arabic_name": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
              "translated_name": "और तुम्हारा साथी कोई दीवाना नहीं हैं।"
            },
            {
              "id": 5823,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "23",
              "arabic_name": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
              "translated_name": "और निश्चय उन्होंने उस (जिबरील) को स्पष्ट क्षितिज पर देखा है।"
            },
            {
              "id": 5824,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "24",
              "arabic_name": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
              "translated_name": "और वह परोक्ष (ग़ैब) की बातें बताने में कृपण नहीं हैं।[4]"
            },
            {
              "id": 5825,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "25",
              "arabic_name": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
              "translated_name": "और यह (क़ुरआन) किसी धिक्कारे हुए शैतान की वाणी नहीं है।"
            },
            {
              "id": 5826,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "26",
              "arabic_name": "فَأَيْنَ تَذْهَبُونَ",
              "translated_name": "फिर तुम कहाँ जा रहे हो?"
            },
            {
              "id": 5827,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "27",
              "arabic_name": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
              "translated_name": "यह तो समस्त संसार वालों के लिए एक उपदेश है।"
            },
            {
              "id": 5828,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "28",
              "arabic_name": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
              "translated_name": "उसके लिए, जो तुममें से सीधे मार्ग पर चलना चाहे।"
            },
            {
              "id": 5829,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "29",
              "arabic_name": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
              "translated_name": "तथा तुम कुछ नहीं चाह सकते, सिवाय इसके कि सर्व संसार का पालनहार अल्लाह चाहे।[5]"
            }
          ],
          "page_arabic_ayah": "إِذَا ٱلشَّمْسُ كُوِّرَتْ (١)  وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ (٢)  وَإِذَا ٱلْجِبَالُ سُيِّرَتْ (٣)  وَإِذَا ٱلْعِشَارُ عُطِّلَتْ (٤)  وَإِذَا ٱلْوُحُوشُ حُشِرَتْ (٥)  وَإِذَا ٱلْبِحَارُ سُجِّرَتْ (٦)  وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ (٧)  وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ (٨)  بِأَىِّ ذَنۢبٍ قُتِلَتْ (٩)  وَإِذَا ٱلصُّحُفُ نُشِرَتْ (١٠)  وَإِذَا ٱلسَّمَآءُ كُشِطَتْ (١١)  وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ (١٢)  وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ (١٣)  عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ (١٤)  فَلَآ أُقْسِمُ بِٱلْخُنَّسِ (١٥)  ٱلْجَوَارِ ٱلْكُنَّسِ (١٦)  وَٱلَّيْلِ إِذَا عَسْعَسَ (١٧)  وَٱلصُّبْحِ إِذَا تَنَفَّسَ (١٨)  إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ (١٩)  ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ (٢٠)  مُّطَاعٍ ثَمَّ أَمِينٍ (٢١)  وَمَا صَاحِبُكُم بِمَجْنُونٍ (٢٢)  وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ (٢٣)  وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ (٢٤)  وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ (٢٥)  فَأَيْنَ تَذْهَبُونَ (٢٦)  إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ (٢٧)  لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ (٢٨)  وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ (٢٩)",
