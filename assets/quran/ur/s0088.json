              "arabic_name": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ",
              "translated_name": "کیا تجھے بھی چھپا لینے والی (قیامت) کی خبر پہنچی ہے.[1]"
            },
            {
              "id": 5969,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ",
              "translated_name": "اس دن بہت سے چہرے ذلیل ہوں گے.[1]"
            },
            {
              "id": 5970,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "عَامِلَةٌ نَّاصِبَةٌ",
              "translated_name": "(اور) محنت کرنے والے تھکے ہوئے ہوں گے.[1]"
            },
            {
              "id": 5971,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "تَصْلَىٰ نَارًا حَامِيَةً",
              "translated_name": "وه دہکتی ہوئی آگ میں جائیں گے."
            },
            {
              "id": 5972,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
              "translated_name": "اور نہایت گرم چشمے کا پانی ان کو پلایا جائے گا.[1]"
            },
            {
              "id": 5973,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
              "translated_name": "ان کے لئے سوائے کانٹے دار درختوں کے اور کچھ کھانے کو نہ ہوگا.[1]"
            },
            {
              "id": 5974,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
              "translated_name": "جو نہ موٹا کرے گا نہ بھوک مٹائے گا."
            },
            {
              "id": 5975,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
              "translated_name": "بہت سے چہرے اس دن تروتازه اور (آسوده حال) ہوں گے."
            },
            {
              "id": 5976,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "لِّسَعْيِهَا رَاضِيَةٌ",
              "translated_name": "اپنی کوشش پر خوش ہوں گے."
            },
            {
              "id": 5977,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "فِى جَنَّةٍ عَالِيَةٍ",
              "translated_name": "بلند وباﻻ جنتوں میں ہوں گے."
            },
            {
              "id": 5978,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً",
              "translated_name": "جہاں کوئی بیہوده بات نہیں سنیں گے."
            },
            {
              "id": 5979,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "فِيهَا عَيْنٌ جَارِيَةٌ",
              "translated_name": "جہاں بہتا ہوا چشمہ ہوگا."
            },
            {
              "id": 5980,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ",
              "translated_name": "(اور) اس میں اونچے اونچے تخت ہوں گے."
            },
            {
              "id": 5981,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "وَأَكْوَابٌ مَّوْضُوعَةٌ",
              "translated_name": "اور آبخورے رکھے ہوئے (ہوں گے)."
            },
            {
              "id": 5982,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "وَنَمَارِقُ مَصْفُوفَةٌ",
              "translated_name": "اور ایک قطار میں لگے ہوئے تکیے ہوں گے."
            },
            {
              "id": 5983,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "وَزَرَابِىُّ مَبْثُوثَةٌ",
              "translated_name": "اور مخملی مسندیں پھیلی پڑی ہوں گی.[1]"
            },
            {
              "id": 5984,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
              "translated_name": "کیا یہ اونٹوں کو نہیں دیکھتے کہ وه کس طرح پیدا کیے گئے ہیں.[1]"
            },
            {
              "id": 5985,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
              "translated_name": "اور آسمان کو کہ کس طرح اونچا کیا گیا ہے.[1]"
            },
            {
              "id": 5986,
