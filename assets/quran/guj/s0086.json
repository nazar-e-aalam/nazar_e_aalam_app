              "arabic_name": "إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ",
              "translated_name": "૪. કોઇ (જીવ) એવો નથી, જેના પર એક દેખરેખ રાખનાર (ફરિશ્તો) ન હોય."
            },
            {
              "id": 5936,
              "chapter_id": 86,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ",
              "translated_name": "૫. માનવીએ જોવું જોઇએ કે તે કઇ વસ્તુથી પેદા કરવામાં આવ્યો છે."
            },
            {
              "id": 5937,
              "chapter_id": 86,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "خُلِقَ مِن مَّآءٍ دَافِقٍ",
              "translated_name": "૬. તે એક ઉછળતા પાણીથી પેદા કરવામાં આવ્યો છે."
            },
            {
              "id": 5938,
              "chapter_id": 86,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ",
              "translated_name": "૭. જે પીઠ અને છાતીનાં હાડકા વચ્ચેથી નીકળે છે."
            },
            {
              "id": 5939,
              "chapter_id": 86,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ",
              "translated_name": "૮. ખરેખર તે (અલ્લાહ) તેને ફરીવાર જીવિત કરવા પર કુદરત ધરાવે છે."
            },
            {
              "id": 5940,
              "chapter_id": 86,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ",
              "translated_name": "૯. જે દિવસે ગુપ્ત રહસ્યોની તપાસ થશે."
            },
            {
              "id": 5941,
              "chapter_id": 86,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ",
              "translated_name": "૧૦. માનવી પાસે ન તો પોતાનું બળ હશે અને ન તો કોઈ તેની મદદ કરનાર હશે."
            },
            {
              "id": 5942,
              "chapter_id": 86,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ",
              "translated_name": "૧૧. કસમ છે આકાશની જે વારંવાર પાણી વરસાવે છે."
            },
            {
              "id": 5943,
              "chapter_id": 86,
              "verses_translate_name": "Verses",
              "verses_number": "12",
