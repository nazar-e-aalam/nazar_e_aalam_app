              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "كِرَامًا كَـٰتِبِينَ",
              "translated_name": "૧૧. જે પ્રતિષ્ઠિત છે, કાર્યો લખનાર,"
