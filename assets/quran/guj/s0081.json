              "verses_translate_name": "Verses",
              "verses_number": "1",
              "arabic_name": "إِذَا ٱلشَّمْسُ كُوِّرَتْ",
              "translated_name": "૧. જ્યારે સૂરજ લપેટી દેવામાં આવશે."
            },
            {
              "id": 5802,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
              "translated_name": "૨. અને જ્યારે તારાઓ પ્રકાશહીન થઇ જશે."
            },
            {
              "id": 5803,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
              "translated_name": "૩. અને જ્યારે પર્વતો ચલાવવામાં આવશે."
            },
            {
              "id": 5804,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
              "translated_name": "૪. અને જ્યારે દસ મહિનાની ગર્ભવાળી ઉંટણીને પોતાની હાલત પર છોડી દેવામાં આવશે."
            },
            {
              "id": 5805,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
              "translated_name": "૫. અને જ્યારે જંગલી જાનવર ભેગા કરવામાં આવશે."
            },
            {
              "id": 5806,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
              "translated_name": "૬. અને જ્યારે દરિયાઓ ભડકાવવામાં આવશે."
            },
            {
              "id": 5807,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
              "translated_name": "૭. અને જ્યારે પ્રાણ (શરીરો સાથે) જોડી દેવામાં આવશે."
            },
            {
              "id": 5808,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
              "translated_name": "૮. અને જ્યારે જીવતી દાટેલી બાળકીને સવાલ કરવામાં આવશે."
            },
            {
              "id": 5809,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
              "translated_name": "૯. કે કયા અપરાધના કારણે મારી નાખવામાં આવી?"
            },
            {
              "id": 5810,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
              "translated_name": "૧૦. અને જ્યારે કર્મનોંધ ખોલી નાખવામાં આવશે."
            },
            {
              "id": 5811,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
              "translated_name": "૧૧. અને જ્યારે આકાશની ખાલ ખેંચી લેવામાં આવશે."
            },
            {
              "id": 5812,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
              "translated_name": "૧૨. અને જ્યારે જહન્નમ ભડકાવવામાં આવશે."
            },
            {
              "id": 5813,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
              "translated_name": "૧૩. અને જ્યારે જન્નત નજીક લાવવામાં આવશે."
            },
            {
              "id": 5814,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
              "translated_name": "૧૪. (તે સમયે) પ્રત્યેક વ્યક્તિ જાણી લેશે જે તે શું લઇને આવ્યો છે."
            },
            {
              "id": 5815,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
              "translated_name": "૧૫. હું પાછળ હટવાવાળા તારાઓની કસમ ખાઉ છું."
            },
            {
              "id": 5816,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "ٱلْجَوَارِ ٱلْكُنَّسِ",
              "translated_name": "૧૬. જે સીધા ચાલતા ચાલતા ગાયબ થઇ જાય છે."
            },
            {
              "id": 5817,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
              "translated_name": "૧૭. અને રાતની, જ્યારે તેનું અંધારું છવાઈ જાય."
            },
            {
              "id": 5818,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
              "translated_name": "૧૮. અને સવારની જ્યારે તે શ્વાસ લેવા લાગે."
            },
            {
              "id": 5819,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
              "translated_name": "૧૯. નિ:શંક આ (કુરઆન) એક ઇઝઝતવાળા ફરિશ્તાની લાવેલી વાણી છે."
            },
            {
              "id": 5820,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "20",
              "arabic_name": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
              "translated_name": "૨૦. જે ઘણો શક્તિશાળી છે. અને અર્શવાળા પાસે તેનો ઉચ્ચ દરજ્જો છે."
            },
            {
              "id": 5821,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "21",
              "arabic_name": "مُّطَاعٍ ثَمَّ أَمِينٍ",
              "translated_name": "૨૧. ત્યાં તેની વાત માનવામાં આવે છે. પ્રામાણિક છે."
            },
            {
              "id": 5822,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "22",
              "arabic_name": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
              "translated_name": "૨૨. અને(મક્કાના કાફીરો) તમારા સાથી પાગલ નથી."
            },
            {
              "id": 5823,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "23",
              "arabic_name": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
              "translated_name": "૨૩. તેણે તેને (જિબ્રઇલ) આકાશોના ખુલ્લા કિનારે જોયા પણ છે."
            },
            {
              "id": 5824,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "24",
              "arabic_name": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
              "translated_name": "૨૪. અને તે ગૈબની વાતો (લોકો સુધી પહોચાડવા માટે) કંજુસ પણ નથી."
            },
            {
              "id": 5825,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "25",
              "arabic_name": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
              "translated_name": "૨૫. અને ન તો આ કુરઆન કોઈ ધિક્કારેલા શયતાનનું કથન છે."
            },
            {
              "id": 5826,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "26",
              "arabic_name": "فَأَيْنَ تَذْهَبُونَ",
              "translated_name": "૨૬. પછી તમે ક્યાં જઇ રહ્યા છો?"
            },
            {
              "id": 5827,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "27",
              "arabic_name": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
              "translated_name": "૨૭. આ સમગ્ર સૃષ્ટિના લોકો માટે એક નસીહત છે."
            },
            {
              "id": 5828,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "28",
              "arabic_name": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
              "translated_name": "૨૮. (ખાસ કરીને) તેમના માટે, જેઓ સીધો માર્ગ પર ચાલવા માંગે."
            },
            {
              "id": 5829,
              "chapter_id": 81,
              "verses_translate_name": "Verses",
              "verses_number": "29",
              "arabic_name": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
              "translated_name": "૨૯. અને તમે ઈચ્છી નથી શકતા પરતું તે જ, જે સમ્રગ સૃષ્ટિનો પાલનહાર ઇચ્છતો હોય."
            }
          ],
          "page_arabic_ayah": "إِذَا ٱلشَّمْسُ كُوِّرَتْ (١)  وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ (٢)  وَإِذَا ٱلْجِبَالُ سُيِّرَتْ (٣)  وَإِذَا ٱلْعِشَارُ عُطِّلَتْ (٤)  وَإِذَا ٱلْوُحُوشُ حُشِرَتْ (٥)  وَإِذَا ٱلْبِحَارُ سُجِّرَتْ (٦)  وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ (٧)  وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ (٨)  بِأَىِّ ذَنۢبٍ قُتِلَتْ (٩)  وَإِذَا ٱلصُّحُفُ نُشِرَتْ (١٠)  وَإِذَا ٱلسَّمَآءُ كُشِطَتْ (١١)  وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ (١٢)  وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ (١٣)  عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ (١٤)  فَلَآ أُقْسِمُ بِٱلْخُنَّسِ (١٥)  ٱلْجَوَارِ ٱلْكُنَّسِ (١٦)  وَٱلَّيْلِ إِذَا عَسْعَسَ (١٧)  وَٱلصُّبْحِ إِذَا تَنَفَّسَ (١٨)  إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ (١٩)  ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ (٢٠)  مُّطَاعٍ ثَمَّ أَمِينٍ (٢١)  وَمَا صَاحِبُكُم بِمَجْنُونٍ (٢٢)  وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ (٢٣)  وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ (٢٤)  وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ (٢٥)  فَأَيْنَ تَذْهَبُونَ (٢٦)  إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ (٢٧)  لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ (٢٨)  وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ (٢٩)",
