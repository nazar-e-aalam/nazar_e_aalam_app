              "arabic_name": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ",
              "translated_name": "૧. શું તમારી પાસે છવાઈ જનારી (કયામત) ની વાત પહોંચી?"
            },
            {
              "id": 5969,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ",
              "translated_name": "૨. તે દિવસે કેટલાક ચહેરા ભયભીત હશે."
            },
            {
              "id": 5970,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "عَامِلَةٌ نَّاصِبَةٌ",
              "translated_name": "૩. (અને) પરિશ્રમ કરનારા થાકેલા હશે."
            },
            {
              "id": 5971,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "تَصْلَىٰ نَارًا حَامِيَةً",
              "translated_name": "૪. તેઓ ભડકતી આગમાં જશે."
            },
            {
              "id": 5972,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
              "translated_name": "૫. અતિશય ઉકળતા ઝરણાનું પાણી તેઓને પીવડાવવામાં આવશે."
            },
            {
              "id": 5973,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
              "translated_name": "૬. તેમના માટે કાંટાવાળા સુકા ઘાસ સિવાય કંઇ ભોજન નહીં હોય."
            },
            {
              "id": 5974,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
              "translated_name": "૭. જે ન હૃષ્ટપૃષ્ટ કરશે અને ન ભુખ દૂર કરશે."
            },
            {
              "id": 5975,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
              "translated_name": "૮. અને કેટલાક ચહેરા તે દિવસે તાજગીભર્યા અને (ખુશહાલ) હશે."
            },
            {
              "id": 5976,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "لِّسَعْيِهَا رَاضِيَةٌ",
              "translated_name": "૯. પોતાના પ્રયત્નોથી ખુશ હશે."
            },
            {
              "id": 5977,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "فِى جَنَّةٍ عَالِيَةٍ",
              "translated_name": "૧૦. ઉચ્ચશ્રેણી ની જન્નતમાં હશે."
            },
            {
              "id": 5978,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً",
              "translated_name": "૧૧. તેમાં કોઇ બકવાસ વાત નહી સાંભળે."
            },
            {
              "id": 5979,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "فِيهَا عَيْنٌ جَارِيَةٌ",
              "translated_name": "૧૨. તેમાં એક વહેતુ ઝરણું હશે."
            },
            {
              "id": 5980,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ",
              "translated_name": "૧૩. (અને) તેમાં ઊંચા-ઊંચા આસન હશે."
            },
            {
              "id": 5981,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "وَأَكْوَابٌ مَّوْضُوعَةٌ",
              "translated_name": "૧૪. તેમાં સામે મુકેલા પ્યાલા (હશે)."
            },
            {
              "id": 5982,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "وَنَمَارِقُ مَصْفُوفَةٌ",
              "translated_name": "૧૫. અને એક કતારમાં મુકેલા તકીયા હશે."
            },
            {
              "id": 5983,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "وَزَرَابِىُّ مَبْثُوثَةٌ",
              "translated_name": "૧૬. અને મખમલી જાજમો ફેલાયેલી હશે."
            },
            {
              "id": 5984,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
              "translated_name": "૧૭. શું તેઓ ઊંટ તરફ જોતા નથી કે તે કઇ રીતે પેદા કરવામાં આવ્યુ છે?"
            },
            {
              "id": 5985,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
              "translated_name": "૧૮. અને આકાશ તરફ, કે કઇ રીતે ઊંચુ કરવામાં આવ્યું છે?"
            },
            {
              "id": 5986,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
              "translated_name": "૧૯. અને પર્વતો તરફ, કે કઇ રીતે ઠોસી દેવામાં આવ્યા છે?"
            },
            {
              "id": 5987,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "20",
              "arabic_name": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
              "translated_name": "૨૦. અને ધરતી તરફ કે કઇ રીતે પાથરવામાં આવી છે?"
            },
            {
              "id": 5988,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "21",
              "arabic_name": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ",
              "translated_name": "૨૧. બસ તમે નસીહત કરતા રહો. (કારણકે) તમે તો ફક્ત નસીહત કરનાર છો."
            },
            {
              "id": 5989,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "22",
              "arabic_name": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
              "translated_name": "૨૨. તમે તેમના ઉપર રખેવાળ નથી."
            },
            {
              "id": 5990,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "23",
              "arabic_name": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
              "translated_name": "૨૩. હા! જે વ્યક્તિ મોઢું ફેરવશે અને કુફ્ર કરશે."
            },
            {
              "id": 5991,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "24",
              "arabic_name": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
              "translated_name": "૨૪. તેને અલ્લાહ તઆલા ભારે સજા આપશે."
            },
            {
              "id": 5992,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "25",
              "arabic_name": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
              "translated_name": "૨૫. ખરેખર અમારા તરફ જ તેમને પાછા ફરવાનું છે."
            },
            {
              "id": 5993,
              "chapter_id": 88,
              "verses_translate_name": "Verses",
              "verses_number": "26",
              "arabic_name": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
              "translated_name": "૨૬. અને ખરેખર તેમનો હિસાબ અમારા શિરે છે."
            }
          ],
          "page_arabic_ayah": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ (١)  وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ (٢)  عَامِلَةٌ نَّاصِبَةٌ (٣)  تَصْلَىٰ نَارًا حَامِيَةً (٤)  تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ (٥)  لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ (٦)  لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ (٧)  وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ (٨)  لِّسَعْيِهَا رَاضِيَةٌ (٩)  فِى جَنَّةٍ عَالِيَةٍ (١٠)  لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً (١١)  فِيهَا عَيْنٌ جَارِيَةٌ (١٢)  فِيهَا سُرُرٌ مَّرْفُوعَةٌ (١٣)  وَأَكْوَابٌ مَّوْضُوعَةٌ (١٤)  وَنَمَارِقُ مَصْفُوفَةٌ (١٥)  وَزَرَابِىُّ مَبْثُوثَةٌ (١٦)  أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ (١٧)  وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ (١٨)  وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ (١٩)  وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ (٢٠)  فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ (٢١)  لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ (٢٢)  إِلَّا مَن تَوَلَّىٰ وَكَفَرَ (٢٣)  فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ (٢٤)  إِنَّ إِلَيْنَآ إِيَابَهُمْ (٢٥)  ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم (٢٦)",
