          "page_verses": [
            {
              "id": 5759,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "1",
              "arabic_name": "عَبَسَ وَتَوَلَّىٰٓ",
              "translated_name": "૧. (પયગંબરે) મોઢું બનાવ્યું, અને મોં ફેરવી લીધું."
            },
            {
              "id": 5760,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
              "translated_name": "૨. (એટલા માટે) કે તેમની પાસે એક અંધ વ્યક્તિ આવી ગયો."
            },
            {
              "id": 5761,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
              "translated_name": "૩. તમને શું ખબર કદાચ તે સુધરવાની ઈચ્છા ધરાવતો."
            },
            {
              "id": 5762,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
              "translated_name": "૪. અથવા શિખામણ પ્રાપ્ત કરતો તો તેને તે શિખામણ લાભ પહોંચાડતી."
            },
            {
              "id": 5763,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
              "translated_name": "૫. પરંતુ જે વ્યક્તિ અવગણના કરે છે."
            },
            {
              "id": 5764,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
              "translated_name": "૬. તો તમે તેની તરફ (તેમની હિદાયત માટે) પૂરતુ ધ્યાન આપી રહ્યા છો."
            },
            {
              "id": 5765,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
              "translated_name": "૭. જો કે તેમના ન સુધારવા થી તમારા પર કોઇ તેમની કોઈ જવાબદારી નથી."
            },
            {
              "id": 5766,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
              "translated_name": "૮. અને જે વ્યક્તિ તમારી પાસે દોડતો આવે છે."
            },
            {
              "id": 5767,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "وَهُوَ يَخْشَىٰ",
              "translated_name": "૯. અને તે ડરી (પણ) રહ્યો છે."
            },
            {
              "id": 5768,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
              "translated_name": "૧૦. તમે તેની તરફ બેધ્યાન છો."
            },
            {
              "id": 5769,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "كَلَّآ إِنَّهَا تَذْكِرَةٌ",
              "translated_name": "૧૧. આવું ઠીક નથી, આ કુરઆન તો એક ઉપદેશ છે."
            },
            {
              "id": 5770,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "فَمَن شَآءَ ذَكَرَهُۥ",
              "translated_name": "૧૨. જે ઈચ્છે તેને યાદ કરી લે."
            },
            {
              "id": 5771,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "فِى صُحُفٍ مُّكَرَّمَةٍ",
              "translated_name": "૧૩. (આ તો) પ્રતિષ્ઠિત સહીફામાં (છે)."
            },
            {
              "id": 5772,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ",
              "translated_name": "૧૪. જે ઉચ્ચ કક્ષાના છે અને પવિત્ર છે."
            },
            {
              "id": 5773,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "بِأَيْدِى سَفَرَةٍ",
              "translated_name": "૧૫. તે એવા લખનારના હાથોમાં રહે છે,"
            },
            {
              "id": 5774,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "كِرَامٍۭ بَرَرَةٍ",
              "translated_name": "૧૬. જેઓ આદરણીય અને પ્રામણિક છે."
            },
            {
              "id": 5775,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ",
              "translated_name": "૧૭. લઅનત થાય ઇન્સાન પર, તે કેવો કૃત્ઘની છે."
            },
            {
              "id": 5776,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
              "translated_name": "૧૮. અલ્લાહએ તેને કઈ વસ્તુ વડે પેદા કર્યો?"
            },
            {
              "id": 5777,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
              "translated_name": "૧૯. એક ટીપા વડે તેને પેદા કર્યો, પછી તેની તકદીર (ભાગ્ય) નક્કી કર્યું."
            },
            {
              "id": 5778,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "20",
              "arabic_name": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
              "translated_name": "૨૦. પછી તેના માટે માર્ગ સરળ કર્યો."
            },
            {
              "id": 5779,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "21",
              "arabic_name": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
              "translated_name": "૨૧. પછી તેને મૃત્યુ આપ્યું, અને પછી કબરમાં દફનાવ્યો."
            },
            {
              "id": 5780,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "22",
              "arabic_name": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
              "translated_name": "૨૨. પછી જ્યારે ઇચ્છશે તેને ફરીવાર જીવિત કરી દેશે."
            },
            {
              "id": 5781,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "23",
              "arabic_name": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
              "translated_name": "૨૩. કદાપિ નહી, જે વાતનો તેને આદેશ આપવામાં આવ્યો હતો, તે આદેશનું પાલન નથી કર્યું."
            },
            {
              "id": 5782,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "24",
              "arabic_name": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ",
              "translated_name": "૨૪. માનવીએ પોતાના ભોજન તરફ ધ્યાન ધરવું જોઈએ."
            },
            {
              "id": 5783,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "25",
              "arabic_name": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا",
              "translated_name": "૨૫. નિ:શંક અમે જ મુશળધાર પાણી વરસાવ્યું."
            },
            {
              "id": 5784,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "26",
              "arabic_name": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا",
              "translated_name": "૨૬. પછી અમે જ ધરતીને ચીરી ફાડી."
            },
            {
              "id": 5785,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "27",
              "arabic_name": "فَأَنۢبَتْنَا فِيهَا حَبًّا",
              "translated_name": "૨૭. પછી અમે જ તેમાં અનાજ ઉગાવ્યું."
            },
            {
              "id": 5786,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "28",
              "arabic_name": "وَعِنَبًا وَقَضْبًا",
              "translated_name": "૨૮. દ્રાક્ષ અને શાકભાજીઓ."
            },
            {
              "id": 5787,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "29",
              "arabic_name": "وَزَيْتُونًا وَنَخْلًا",
              "translated_name": "૨૯. જૈતૂન અને ખજુરો."
            },
            {
              "id": 5788,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "30",
              "arabic_name": "وَحَدَآئِقَ غُلْبًا",
              "translated_name": "૩૦. અને હર્યા-ભર્યા બગીચા."
            },
            {
              "id": 5789,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "31",
              "arabic_name": "وَفَـٰكِهَةً وَأَبًّا",
              "translated_name": "૩૧. અને ફળો તેમજ (ઘાસ) ચારો (પણ) ઉગાવ્યો."
            },
            {
              "id": 5790,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "32",
              "arabic_name": "مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
              "translated_name": "૩૨. આ બધું તમારા અને તમારા પશુઓ ના ફાયદા માટે ઉગાડ્યું."
            },
            {
              "id": 5791,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "33",
              "arabic_name": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
              "translated_name": "૩૩. બસ! જ્યારે કાન બહેરા કરી નાખનારી (કયામત) આવી જશે."
            },
            {
              "id": 5792,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "34",
              "arabic_name": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
              "translated_name": "૩૪. તે દિવસે માનવી પોતાના સગાભાઇથી ભાગશે."
            },
            {
              "id": 5793,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "35",
              "arabic_name": "وَأُمِّهِۦ وَأَبِيهِ",
              "translated_name": "૩૫. અને પોતાની માતા તેમજ પિતાથી,"
            },
            {
              "id": 5794,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "36",
              "arabic_name": "وَصَـٰحِبَتِهِۦ وَبَنِيهِ",
              "translated_name": "૩૬. અને પોતાની પત્નિ તેમજ પુત્રોથી ભાગશે."
            },
            {
              "id": 5795,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "37",
              "arabic_name": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ",
              "translated_name": "૩૭. તે દિવસે દરેક વ્યક્તિની એવી પરિસ્થિતિ હશે, જે તેને (બીજાથી) અળગો કરી દેશે."
            },
            {
              "id": 5796,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "38",
              "arabic_name": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ",
              "translated_name": "૩૮. તે દિવસે કેટલાક ચહેરા ચમકતા હશે."
            },
            {
              "id": 5797,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "39",
              "arabic_name": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ",
              "translated_name": "૩૯. (જે) હસતા તેમજ પ્રફુલ્લિત હશે."
            },
            {
              "id": 5798,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "40",
              "arabic_name": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ",
              "translated_name": "૪૦. અને કેટલાક ચહેરાઓ પર તે દિવસે ધૂળ લાગેલી હશે."
            },
            {
              "id": 5799,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "41",
              "arabic_name": "تَرْهَقُهَا قَتَرَةٌ",
              "translated_name": "૪૧. તેમના પર કાળાશ છવાયેલી હશે."
            },
            {
              "id": 5800,
              "chapter_id": 80,
              "verses_translate_name": "Verses",
              "verses_number": "42",
              "arabic_name": "أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
              "translated_name": "૪૨. અને તેઓ તે લોકો હશે, જેઓ કાફિર અને દુરાચારી હતા."
            }
          ],
          "page_arabic_ayah": "عَبَسَ وَتَوَلَّىٰٓ (١)  أَن جَآءَهُ ٱلْأَعْمَىٰ (٢)  وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ (٣)  أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ (٤)  أَمَّا مَنِ ٱسْتَغْنَىٰ (٥)  فَأَنتَ لَهُۥ تَصَدَّىٰ (٦)  وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ (٧)  وَأَمَّا مَن جَآءَكَ يَسْعَىٰ (٨)  وَهُوَ يَخْشَىٰ (٩)  فَأَنتَ عَنْهُ تَلَهَّىٰ (١٠)  كَلَّآ إِنَّهَا تَذْكِرَةٌ (١١)  فَمَن شَآءَ ذَكَرَهُۥ (١٢)  فِى صُحُفٍ مُّكَرَّمَةٍ (١٣)  مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ (١٤)  بِأَيْدِى سَفَرَةٍ (١٥)  كِرَامٍۭ بَرَرَةٍ (١٦)  قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ (١٧)  مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ (١٨)  مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ (١٩)  ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ (٢٠)  ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ (٢١)  ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ (٢٢)  كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ (٢٣)  فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ (٢٤)  أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا (٢٥)  ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا (٢٦)  فَأَنۢبَتْنَا فِيهَا حَبًّا (٢٧)  وَعِنَبًا وَقَضْبًا (٢٨)  وَزَيْتُونًا وَنَخْلًا (٢٩)  وَحَدَآئِقَ غُلْبًا (٣٠)  وَفَـٰكِهَةً وَأَبًّا (٣١)  مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ (٣٢)  فَإِذَا جَآءَتِ ٱلصَّآخَّةُ (٣٣)  يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ (٣٤)  وَأُمِّهِۦ وَأَبِيهِ (٣٥)  وَصَـٰحِبَتِهِۦ وَبَنِيهِ (٣٦)  لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ (٣٧)  وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ (٣٨)  ضَاحِكَةٌ مُّسْتَبْشِرَةٌ (٣٩)  وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ (٤٠)  تَرْهَقُهَا قَتَرَةٌ (٤١)  أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ (٤٢)",
          "is_read": false
        }
      ]
    }
  }
