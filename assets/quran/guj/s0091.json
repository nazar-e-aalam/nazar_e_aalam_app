              "arabic_name": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
              "translated_name": "૪. અને રાતની કસમ, જ્યારે તે તેને ઢાકી દેં."
            },
            {
              "id": 6048,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
              "translated_name": "૫. કસમ છે આકાશની અને તે હસ્તીની જેણે તેને બનાવ્યું."
            },
            {
              "id": 6049,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
              "translated_name": "૬. અને ધરતીની કસમ, અને તે હસ્તીની જેણે તેને પાથરી દીધી."
            },
            {
              "id": 6050,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "وَنَفْسٍ وَمَا سَوَّىٰهَا",
              "translated_name": "૭. કસમ છે, પ્રાણની અને તેની, જેણે તેને ઠીક કરી બનાવ્યું."
            },
            {
              "id": 6051,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
              "translated_name": "૮. પછી તેના દિલમાં તે વાતો પણ નાખી દીધી, જે તેના માટે ખરાબ હોય અને તે વાતો પણ, જે તેના માટે ડરવાવાળી હોય."
            },
            {
              "id": 6052,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
              "translated_name": "૯. સફળ તે બની ગયો, જેણે પોતાના મનને સુધારી દીધું."
            },
            {
              "id": 6053,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
              "translated_name": "૧૦. અને જેણે તેને મેલુ કર્યુ તે નિષ્ફળ થયો"
            },
            {
              "id": 6054,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
              "translated_name": "૧૧. (કોમ) ષમૂદે પોતાના વિદ્રોહના કારણે (સત્યને) જુઠલાવ્યું."
            },
            {
              "id": 6055,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
              "translated_name": "૧૨. જ્યારે તેમના માંનો મોટો દુર્ભાગી વ્યક્તિ ઉભો થયો."
            },
            {
              "id": 6056,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا",
              "translated_name": "૧૩. તેમને અલ્લાહના પયગંબરે કહી દીધુ હતું કે અલ્લાહ તઆલાની ઊંટણીઅને તેની પીવાનીવારી ની (સુરક્ષા કરો)."
            },
            {
              "id": 6057,
              "chapter_id": 91,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
              "translated_name": "૧૪. તે લોકોએ પોતાના પયગંબરને જુઠલાવ્યા, તે ઊંટણી ના હાથ-પગ કાપી નાખ્યા. બસ! તેમના પાલનહારે તેમના ગુનાહોના કારણે તેમના ઉપર એવી આપત્તિ ઉતારી કે તેમને નષ્ટ કરી સપાટ કરી દીધા."
            },
