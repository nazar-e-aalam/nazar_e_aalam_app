            {
              "id": 5728,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
              "translated_name": "૧૬. જ્યારે પવિત્ર ઘાટી “તૂવા” માં તેમને તેમના પાલનહારે પોકાર્યો."
            },
            {
              "id": 5729,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
              "translated_name": "૧૭. (કે) તમે ફિરઔન પાસે જાઓ, તે વિદ્રોહી બની ગયો છે."
            },
            {
              "id": 5730,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
              "translated_name": "૧૮. અને તેને કહો, શું તું તારી ઈસ્લાહ કરવા ઈચ્છે છે?"
            },
            {
              "id": 5731,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
              "translated_name": "૧૯. અને એ કે હું તને તારા પાલનહારનો માર્ગ બતાવું, જેથી તુ (તેનાથી) ડરવા લાગે."
            },
            {
              "id": 5732,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "20",
              "arabic_name": "فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ",
              "translated_name": "૨૦. પછી તેને (મૂસાએ) મોટી નિશાની બતાવી."
            },
            {
              "id": 5733,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "21",
              "arabic_name": "فَكَذَّبَ وَعَصَىٰ",
              "translated_name": "૨૧. તો તેણે જુઠલાવ્યું અને અવગણના કરી."
            },
            {
              "id": 5734,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "22",
              "arabic_name": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
              "translated_name": "૨૨. પછી પીઠ બતાવીને યુક્તિઓ કરવા લાગ્યો."
            },
            {
              "id": 5735,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "23",
              "arabic_name": "فَحَشَرَ فَنَادَىٰ",
              "translated_name": "૨૩. તેણે સૌને ભેગા કરી પોકાર્યા."
            },
            {
              "id": 5736,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "24",
              "arabic_name": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
              "translated_name": "૨૪. કહેવા લાગ્યો, હું તમારા સૌનો ઉચ્ચ પાલનહાર છું."
            },
            {
              "id": 5737,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "25",
              "arabic_name": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ",
              "translated_name": "૨૫. તો અલ્લાહ તેને આખિરત અને દુનિયાના અઝાબમાં પકડી લીધો."
            },
            {
              "id": 5738,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "26",
              "arabic_name": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ",
              "translated_name": "૨૬. આ કિસ્સામાં નસીહત છે, તે વ્યક્તિ માટે જે (અલ્લાહની પકડથી) ડરતો હોય."
            },
            {
              "id": 5739,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "27",
              "arabic_name": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
              "translated_name": "૨૭. શું તમને પેદા કરવું વધારે મુશ્કેલ છે કે આકાશનું? જેને તેણે બનાવ્યું."
            },
            {
              "id": 5740,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "28",
              "arabic_name": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
              "translated_name": "૨૮. તેની છત ઊંચી ઉઠાવી અને તેને સંતુલન આપ્યું."
            },
            {
              "id": 5741,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "29",
              "arabic_name": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
              "translated_name": "૨૯. અને તેની રાતને અંધારી બનાવી અને દિવસને પ્રકાશિત કર્યો."
            },
            {
              "id": 5742,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "30",
              "arabic_name": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
              "translated_name": "૩૦. અને ત્યારપછી ધરતીને (સમતોલ) પાથરી દીધી."
            },
            {
              "id": 5743,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "31",
              "arabic_name": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
              "translated_name": "૩૧. તેનાથી પાણી અને ઘાસ-ચારો ઉપજાવ્યો."
            },
            {
              "id": 5744,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "32",
              "arabic_name": "وَٱلْجِبَالَ أَرْسَىٰهَا",
              "translated_name": "૩૨. અને પર્વતોને (સખત) ઠોસી દીધા."
            },
            {
              "id": 5745,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "33",
              "arabic_name": "مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
              "translated_name": "૩૩. આ બધુ તમારા અને તમારા પશુઓના લાભ માટે (છે)."
            },
            {
              "id": 5746,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "34",
              "arabic_name": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ",
              "translated_name": "૩૪. તો જ્યારે મોટી આફત આવી જશે."
            },
            {
              "id": 5747,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "35",
              "arabic_name": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ",
              "translated_name": "૩૫. તે દિવસ માનવી પોતાના કર્મોને યાદ કરશે."
            },
            {
              "id": 5748,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "36",
              "arabic_name": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ",
              "translated_name": "૩૬. અને (દરેક) જોવાવાળા સામે જહન્નમ લાવવામાં આવશે."
            },
            {
              "id": 5749,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "37",
              "arabic_name": "فَأَمَّا مَن طَغَىٰ",
              "translated_name": "૩૭. તો જે (માનવીએ) અવજ્ઞા કરી (હશે)."
            },
            {
              "id": 5750,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "38",
              "arabic_name": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
              "translated_name": "૩૮. અને દુન્યવી જીવનને પ્રાથમિકતા આપી (હશે)."
            },
            {
              "id": 5751,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "39",
              "arabic_name": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
              "translated_name": "૩૯. (તેનું) ઠેકાણું જહન્નમ જ હશે."
            },
            {
              "id": 5752,
              "chapter_id": 79,
