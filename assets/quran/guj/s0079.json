              "arabic_name": "وَٱلنَّـٰزِعَـٰتِ غَرْقًا",
              "translated_name": "૧. કસમ છે તે (ફરિશ્તાઓની) જેઓ (કાફિરોની રૂહ) સખતી સાથે ખેંચે છે."
            },
            {
              "id": 5714,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "وَٱلنَّـٰشِطَـٰتِ نَشْطًا",
              "translated_name": "૨. અને તે (ફરિશ્તાની) કસમ! જે (મોમિનોની રૂહ) નરમી સાથે ખોલી નાખે છે."
            },
            {
              "id": 5715,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "وَٱلسَّـٰبِحَـٰتِ سَبْحًا",
              "translated_name": "૩. અને તેમની કસમ! જે સૃષ્ટિમાં ઝડપથી તરે-ફરે છે."
            },
            {
              "id": 5716,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "فَٱلسَّـٰبِقَـٰتِ سَبْقًا",
              "translated_name": "૪. પછી દોડીને એકબીજાથી આગળ વધનારાઓની કસમ!"
            },
            {
              "id": 5717,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "فَٱلْمُدَبِّرَٰتِ أَمْرًا",
              "translated_name": "૫. પછી તેમની કસમ! જેઓ આદેશ મળ્યા પછી તેને (પૂરો કરવાની) વ્યવસ્થા કરે છે."
            },
            {
              "id": 5718,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
              "translated_name": "૬. જે દિવસ ધ્રુજવાવાળી જમીન ધ્રુજવા લાગશે."
            },
            {
              "id": 5719,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "تَتْبَعُهَا ٱلرَّادِفَةُ",
              "translated_name": "૭. ત્યારપછી એકબીજો ઝટકો આવશે."
            },
            {
              "id": 5720,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",
              "translated_name": "૮. તેનાથી (કેટલાક) હૃદય ધ્રુજી રહ્યા હશે."
            },
            {
              "id": 5721,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "أَبْصَـٰرُهَا خَـٰشِعَةٌ",
              "translated_name": "૯. તેમની આંખો ઝુકેલી હશે."
            },
            {
              "id": 5722,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
              "translated_name": "૧૦. તે મક્કાનાં કાફિરો કહેશે કે શું અમે ફરી પહેલાની સ્થિતિમાં લાવવામાં આવીશું?"
            },
            {
              "id": 5723,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً",
              "translated_name": "૧૧. તે સમયે જ્યારે કે અમે ઓગળી ગયેલા હાડકા થઇ જઇશું?"
            },
            {
              "id": 5724,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
              "translated_name": "૧૨. કહે છે, પછી તો આ પાછુ ફરવુ નુકશાનકારક રહેશે."
            },
            {
              "id": 5725,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ",
              "translated_name": "૧૩. સત્ય વાત એ છે કે તે એક સખત અવાજ હશે."
            },
            {
              "id": 5726,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
              "translated_name": "૧૪. તેના પછી તેઓ એક સપાટ મેદાનમાં હશે."
            },
            {
              "id": 5727,
              "chapter_id": 79,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
              "translated_name": "૧૫. શું તમને મૂસા ની વાત પહોંચી છે?"
            }
          ],
          "page_arabic_ayah": "وَٱلنَّـٰزِعَـٰتِ غَرْقًا (١)  وَٱلنَّـٰشِطَـٰتِ نَشْطًا (٢)  وَٱلسَّـٰبِحَـٰتِ سَبْحًا (٣)  فَٱلسَّـٰبِقَـٰتِ سَبْقًا (٤)  فَٱلْمُدَبِّرَٰتِ أَمْرًا (٥)  يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ (٦)  تَتْبَعُهَا ٱلرَّادِفَةُ (٧)  قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ (٨)  أَبْصَـٰرُهَا خَـٰشِعَةٌ (٩)  يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ (١٠)  أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً (١١)  قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ (١٢)  فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ (١٣)  فَإِذَا هُم بِٱلسَّاهِرَةِ (١٤)  هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ (١٥)",
