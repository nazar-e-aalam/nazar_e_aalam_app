              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "كَلَّا لَا وَزَرَ",
              "translated_name": "૧૧. ના ના તેને કોઇ પનાહની જગ્યા નહીં મળે."
            },
            {
              "id": 5563,
              "chapter_id": 75,
              "verses_translate_name": "Verses",
              "verses_number": "12",
