              "arabic_name": "وَٱلْمُرْسَلَـٰتِ عُرْفًا",
              "translated_name": "૧. તે હવાઓની કસમ! જે ધીમી ધીમે ચાલે છે."
            },
            {
              "id": 5624,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "2",
              "arabic_name": "فَٱلْعَـٰصِفَـٰتِ عَصْفًا",
              "translated_name": "૨. પછી તીવ્ર હવાઓની કસમ!"
            },
            {
              "id": 5625,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "3",
              "arabic_name": "وَٱلنَّـٰشِرَٰتِ نَشْرًا",
              "translated_name": "૩. પછી ઉકસાવીને વેરવિખેર કરનારા (વાદળોની) કસમ!."
            },
            {
              "id": 5626,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "4",
              "arabic_name": "فَٱلْفَـٰرِقَـٰتِ فَرْقًا",
              "translated_name": "૪. પછી સત્ય અને અસત્યને અલગ કરી દેનાર (ફરિશ્તાઓ)ની કસમ!"
            },
            {
              "id": 5627,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "5",
              "arabic_name": "فَٱلْمُلْقِيَـٰتِ ذِكْرًا",
              "translated_name": "૫. અને વહી લાવનારા ફરિશ્તાઓની કસમ!"
            },
            {
              "id": 5628,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "6",
              "arabic_name": "عُذْرًا أَوْ نُذْرًا",
              "translated_name": "૬. જે (વહી) પૂરાવા અને સચેત કરવા માટે છે."
            },
            {
              "id": 5629,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "7",
              "arabic_name": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ",
              "translated_name": "૭. જે વસ્તુનું વચન તમને આપવામાં આવે છે, તે નિ:શંક તે થઇને જ રહેશે."
            },
            {
              "id": 5630,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "8",
              "arabic_name": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
              "translated_name": "૮. જ્યારે તારાઓ પ્રકાશહીન થઇ જશે."
            },
            {
              "id": 5631,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "9",
              "arabic_name": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
              "translated_name": "૯. અને જ્યારે આકાશ ફોડી નાખવામાં આવશે."
            },
            {
              "id": 5632,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "10",
              "arabic_name": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
              "translated_name": "૧૦. અને જ્યારે પર્વતો ટુકડે ટુકડા કરી ઉડાવી દેવામાં આવશે."
            },
            {
              "id": 5633,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "11",
              "arabic_name": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
              "translated_name": "૧૧. અને જ્યારે પયગંબરોને નક્કી કરેલ સમયે હાજર કરવામાં આવશે."
            },
            {
              "id": 5634,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "12",
              "arabic_name": "لِأَىِّ يَوْمٍ أُجِّلَتْ",
              "translated_name": "૧૨. કેવા દિવસ માટે (આ બાબતમાં) વિલંબ કરવામાં આવ્યો."
            },
            {
              "id": 5635,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "13",
              "arabic_name": "لِيَوْمِ ٱلْفَصْلِ",
              "translated_name": "૧૩. નિર્ણયના દિવસ માટે"
            },
            {
              "id": 5636,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "14",
              "arabic_name": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
              "translated_name": "૧૪. અને તને શું ખબર કે નિર્ણયનો દિવસ શું છે?"
            },
            {
              "id": 5637,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "15",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "૧૫. તે દિવસ જુઠલાવનારાઓ માટે વિનાશ છે."
            },
            {
              "id": 5638,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "16",
              "arabic_name": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ",
              "translated_name": "૧૬. શું અમે પહેલાના લોકોને નષ્ટ નથી કર્યા?"
            },
            {
              "id": 5639,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "17",
              "arabic_name": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ",
              "translated_name": "૧૭. ફરી અમે તેમના પછી બીજાને મોકલતા રહીએ છીએ."
            },
            {
              "id": 5640,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "18",
              "arabic_name": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
              "translated_name": "૧૮. અમે દુરાચારીઓ સાથે આવું જ કરીએ છીએ."
            },
            {
              "id": 5641,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "19",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "૧૯. તે દિવસ જુઠલાવનારાઓ માટે વિનાશ છે."
            }
          ],
          "page_arabic_ayah": "وَٱلْمُرْسَلَـٰتِ عُرْفًا (١)  فَٱلْعَـٰصِفَـٰتِ عَصْفًا (٢)  وَٱلنَّـٰشِرَٰتِ نَشْرًا (٣)  فَٱلْفَـٰرِقَـٰتِ فَرْقًا (٤)  فَٱلْمُلْقِيَـٰتِ ذِكْرًا (٥)  عُذْرًا أَوْ نُذْرًا (٦)  إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ (٧)  فَإِذَا ٱلنُّجُومُ طُمِسَتْ (٨)  وَإِذَا ٱلسَّمَآءُ فُرِجَتْ (٩)  وَإِذَا ٱلْجِبَالُ نُسِفَتْ (١٠)  وَإِذَا ٱلرُّسُلُ أُقِّتَتْ (١١)  لِأَىِّ يَوْمٍ أُجِّلَتْ (١٢)  لِيَوْمِ ٱلْفَصْلِ (١٣)  وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ (١٤)  وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ (١٥)  أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ (١٦)  ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ (١٧)  كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ (١٨)  وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ (١٩)",
