              "verses_number": "20",
              "arabic_name": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ",
              "translated_name": "૨૦. શું અમે તમને તુચ્છ પાણી (વિર્ય) થી પૈદા નથી કર્યા?"
            },
            {
              "id": 5643,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "21",
              "arabic_name": "فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ",
              "translated_name": "૨૧. પછી અમે તેને એક સુરક્ષીત જગ્યાએ રાખ્યું."
            },
            {
              "id": 5644,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "22",
              "arabic_name": "إِلَىٰ قَدَرٍ مَّعْلُومٍ",
              "translated_name": "૨૨. એક નક્કી કરેલ સમય સુધી."
            },
            {
              "id": 5645,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "23",
              "arabic_name": "فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ",
              "translated_name": "૨૩. પછી અમે અંદાજો કર્યો. અને અમે ખુબ જ ઉત્તમ અંદાજો કરનારા છે."
            },
            {
              "id": 5646,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "24",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "૨૪. તે દિવસ જુઠલાવનારાઓ માટે વિનાશ છે."
            },
            {
              "id": 5647,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "25",
              "arabic_name": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
              "translated_name": "૨૫. શું અમે ધરતીને સમેટવાવાળી ન બનાવી?"
            },
            {
              "id": 5648,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "26",
              "arabic_name": "أَحْيَآءً وَأَمْوَٰتًا",
              "translated_name": "૨૬. જીવિત લોકોને પણ અને મૃતકોને પણ."
            },
            {
              "id": 5649,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "27",
              "arabic_name": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا",
              "translated_name": "૨૭. અને અમે આમાં ઊંચા અને ભારે પર્વતો બનાવી દીધા અને તમને મીઠું પાણી પીવડાવ્યું."
            },
            {
              "id": 5650,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "28",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "૨૮. તે દિવસ જુઠલાવનારાઓ માટે વિનાશ છે."
            },
            {
              "id": 5651,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "29",
              "arabic_name": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
              "translated_name": "૨૯. ચાલો! તે જ જહન્નમ તરફ, જેને તમે જુઠલાવતા રહ્યા."
            },
            {
              "id": 5652,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "30",
              "arabic_name": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ",
              "translated_name": "૩૦. ચાલો! તે ત્રણ શાખાઓવાળા છાંયડા તરફ."
            },
            {
              "id": 5653,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "31",
              "arabic_name": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
              "translated_name": "૩૧. જે ન તો તે છાયડો ઠંડો હશે અને ન તો લૂ થી બચાવશે."
            },
            {
              "id": 5654,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "32",
              "arabic_name": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ",
              "translated_name": "૩૨. તે એટલા મોટા મોટા આગના ગોળા ફેંકશે, જે મહેલ જેવા હશે."
            },
            {
              "id": 5655,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "33",
              "arabic_name": "كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ",
              "translated_name": "૩૩. (ઉછળવાનાં કારણે એવા લાગશે) કે જેવું કે તે પીળા ઊંટો છે."
            },
            {
              "id": 5656,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "34",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "૩૪. તે દિવસ જુઠલાવનારાઓ માટે વિનાશ છે."
            },
            {
              "id": 5657,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "35",
              "arabic_name": "هَـٰذَا يَوْمُ لَا يَنطِقُونَ",
              "translated_name": "૩૫. આજ (નો દિવસ) એવો હશે કે તેઓ કઈ પણ બોલી નહીં શકે."
            },
            {
              "id": 5658,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "36",
              "arabic_name": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ",
              "translated_name": "૩૬. અને ન તેમને બહાના માટે કોઈ તક આપવામાં આવશે."
            },
            {
              "id": 5659,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "37",
              "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
              "translated_name": "૩૭. તે દિવસ જુઠલાવનારાઓ માટે વિનાશ છે."
            },
            {
              "id": 5660,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "38",
              "arabic_name": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ",
              "translated_name": "૩૮. આ છે નિર્ણયનો દિવસ, અમે તમને અને આગળના દરેક લોકોને એકઠા કરી દીધા છે."
            },
            {
              "id": 5661,
              "chapter_id": 77,
              "verses_translate_name": "Verses",
              "verses_number": "39",
              "arabic_name": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ",
              "translated_name": "૩૯. બસ! જો તમે મારી વિરૂધ્ધ કોઇ યુક્તિ કરી શકતા હોય તો કરી લોં."
            },
            {
